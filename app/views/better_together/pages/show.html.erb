<% content_for :page_title do %>
  <%= @page.title %>
<% end %>

<% content_for :og_title do %>
  <%= t('og.page.title', title: @page.title, platform_name: host_platform.name) %>
<% end %>

<% content_for :og_description do %>
  <%= @page.meta_description.presence || t('og.page.description_fallback', title: @page.title, platform_name: host_platform.name) %>
<% end %>

<% if @page.meta_description.present? %>
  <% content_for :meta_description do %>
    <%= @page.meta_description %>
  <% end %>
<% end %>

<% if @page.keywords.present? %>
  <% content_for :meta_keywords do %>
    <%= @page.keywords %>
  <% end %>
<% end %>

<% content_for :og_url do %>
  <%= @page.url %>
<% end %>

<% if @page.primary_image&.attached? %>
  <% content_for :og_image do %>
    <%= storage_proxy_url_for(@page.primary_image) %>
  <% end %>
<% end %>

<% content_for :editor_status do %>
  <% if policy(@page).index? %>
    <li class="nav-item record-list" data-bs-toggle="tooltip" data-bs-placement="bottom" title="<%= t('globals.back_to_list') %>">
      <%= link_to pages_path, class: 'nav-link' do %>
        <i class="fas fa-list"></i>
      <% end %>
    </li>
  <% end %>
  <% if policy(@page).update? %>
    <li class="nav-item edit" data-bs-toggle="tooltip" data-bs-placement="bottom" title="<%= t('globals.edit') %>">
      <%= link_to edit_page_path(@page, locale: I18n.locale), class: 'nav-link', target: "_#{dom_id(@page, 'edit')}" do %>
        <i class="fas fa-pencil"></i>
      <% end %>
    </li>
  <% end %>
<% end %>

  <!-- Cache the page content for better performance -->
  <% cache page_show_cache_key(@page) do %>
    <% content_for :page_content do %>
    <% @content_blocks.each do |content_block| %>
      <% if @viewer_is_page_editor && !content_block.privacy_public? %>
        <div class="bt-content-block-privacy-badge container my-2">
          <%= privacy_badge(content_block) %>
        </div>
      <% end %>
      <%= render content_block %>
    <% end %>
  <% end %>

  <%= render layout: @layout do %>
    <% if @page.template.present? && @content_blocks.size.zero? %>
      <%= render template: @page.template %>
    <% else %>
      <%# Hero visibility is decided in the controller (@hero_block). The gate must
          stay OUTSIDE the cache: entering the cache block and rendering nothing
          would write an empty shared fragment under a viewer-independent key. %>
      <% if @hero_block %>
        <% if @viewer_is_page_editor && !@hero_block.privacy_public? %>
          <div class="bt-content-block-privacy-badge container my-2"><%= privacy_badge(@hero_block) %></div>
        <% end %>
        <% cache ['page-hero', @page.id, @hero_block.updated_at, I18n.locale] do %>
          <%= render @hero_block %>
        <% end %>
      <% end %>
      <% if @page.show_title || (contributor_display_visible_for?(@page) && @page.agent_authors.any?) %>
        <% title_wrapper_classes = @page.layout&.include?('full_width') ? 'my-4' : 'container my-4' %>
        <div class="<%= title_wrapper_classes %>">
          <% unless @hero_block %>
            <% if @page.show_title %>
              <h1 class="page-title"><%= @page.title %></h1>
            <% end %>
          <% end %>

          <% if contributor_display_visible_for?(@page) && @page.agent_authors.any? %>
            <div class="<%= 'mt-3' unless @hero_block %>">
              <%= render 'better_together/shared/agent_authors',
                         authors: @page.agent_authors,
                         flex_layout: 'flex-row',
                         flex_align_items: 'center' %>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if @page.sidebar_nav.present? %>
        <%= render layout: 'better_together/pages/sidebar_layout', locals: { nav: @page.sidebar_nav, current_page: @page } do %>
          <%= yield :page_content %>
        <% end %>
      <% else %>
        <%= yield :page_content %>
      <% end %>

      <%= share_buttons(shareable: @page) if @page.privacy_public? %>
      <%= render 'shared/page_feedback_bar', record: @page if content_actions_visible_for?(@page) %>
    <% end %>
  <% end %>
<% end %>
