<turbo-frame id="new_billing_report">
  <h3><%= t('better_together.metrics.billing_reports.new_title') %></h3>

  <%= form_with model: @billing_report, url: metrics_billing_reports_path, local: true, id: 'billing-report-form', class: 'form' do |f| %>
    <div class="form-group">
      <%= f.label :from_date, t('views.labels.from_date'), for: 'billing-report-from' %>
      <%= f.date_field :from_date, name: 'metrics_billing_report[filters][from_date]', id: 'billing-report-from', class: 'form-control', required: true %>
    </div>
    <div class="form-group">
      <%= f.label :to_date, t('views.labels.to_date'), for: 'billing-report-to' %>
      <%= f.date_field :to_date, name: 'metrics_billing_report[filters][to_date]', id: 'billing-report-to', class: 'form-control', required: true %>
    </div>
    <div class="form-group mt-3">
      <%= f.label :interval, t('better_together.metrics.filters.additional.interval'), for: 'billing-report-interval' %>
      <%= select_tag 'metrics_billing_report[filters][interval]', options_for_select(BetterTogether::Billing::TaxReport::INTERVALS.map { |i| [t("better_together.metrics.filters.additional.intervals.#{i}"), i] }), id: 'billing-report-interval', class: 'form-select' %>
    </div>
    <div class="form-group mt-3">
      <%= f.label :basis, t('better_together.metrics.filters.additional.basis'), for: 'billing-report-basis' %>
      <%= select_tag 'metrics_billing_report[filters][basis]', options_for_select(BetterTogether::Billing::TaxReport::INTERVALS.map { |i| [t("better_together.metrics.filters.additional.basiss.#{i}"), i] }), id: 'billing-report-basis', class: 'form-select' %>
    </div>
    <div class="form-group mt-3">
      <%= f.label :owner, t('better_together.metrics.filters.additional.owner'), for: 'billing-report-owner' %>
      <%= select_tag 'metrics_billing_report[filters][owner]', options_for_select(billing_filter_options(metrics_platform)[:owners]), id: 'billing-report-owner', class: 'form-select' %>
    </div>
    <div class="form-group mt-3">
      <%= f.label :file_format, t('views.labels.file_format'), for: 'billing-report-format' %>
      <%= f.select :file_format, options_for_select([['CSV', 'csv']], 'csv'), {}, name: 'metrics_billing_report[file_format]', id: 'billing-report-format', class: 'form-select' %>
    </div>
    <div class="form-group mt-3">
      <%= f.submit t('views.buttons.create_report'), id: 'billing-report-submit', class: 'btn btn-primary' %>
      <%= link_to t('views.buttons.back'), metrics_billing_reports_path, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</turbo-frame>
