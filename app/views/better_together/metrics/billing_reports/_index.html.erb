<turbo-frame id="billing_reports">
  <h2><%= t('better_together.metrics.billing_reports.title') %></h2>

  <% if BetterTogether::Metrics::BillingReportPolicy.new(current_user, [:metrics, :billing_report]).create? %>
    <%= link_to t('views.buttons.new', resource: t('resources.report')), new_metrics_billing_report_path, class: 'btn btn-primary mb-3',
                id: 'billing-report-new-link', data: { turbo_frame: 'new_billing_report' } %>
  <% end %>

  <turbo-frame id="new_billing_report"></turbo-frame>

  <div id="billing_reports_content" class="mt-3" data-controller="better_together--user-account-reports">
    <% if billing_reports.any? %>
      <div class="table-responsive">
        <table id="billing-reports-table" class="table table-striped">
          <thead>
            <tr>
              <th><%= t('views.labels.created_at') %></th>
              <th><%= t('views.labels.creator') %></th>
              <th><%= t('views.labels.filters') %></th>
              <th><%= t('views.labels.file_format') %></th>
              <th><%= t('views.labels.actions') %></th>
            </tr>
          </thead>
          <tbody id="billing_reports_table_body">
            <%= render partial: 'better_together/metrics/billing_reports/billing_report', collection: billing_reports, as: :billing_report %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div id="billing_reports_empty_state" class="text-center py-5">
        <i class="fas fa-file-csv fa-3x text-muted mb-3" aria-hidden="true"></i>
        <h4 class="text-muted"><%= t('better_together.metrics.billing_reports.empty_title') %></h4>
        <p class="text-muted"><%= t('better_together.metrics.billing_reports.empty_description') %></p>
      </div>
    <% end %>
  </div>
</turbo-frame>
