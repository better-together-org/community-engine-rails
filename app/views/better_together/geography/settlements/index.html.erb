<% content_for :page_title do %>
  <%= t('.title') %>
<% end %>

<div class="container my-3">
  <h1><%= t('.title') %></h1>
  <p id="settlements-description" class="text-muted"><%= t('.description') %></p>

  <%= render 'better_together/geography/settlements/index_extra', settlements: @geography_settlements %>

  <div class="row">
    <div class="col">
      <table id="settlements-table" class="table" aria-describedby="settlements-description">
        <thead>
          <tr>
            <th><%= ::BetterTogether::Geography::Settlement.human_attribute_name(:name) %></th>
            <th><%= ::BetterTogether::Geography::Settlement.human_attribute_name(:state) %></th>
            <th><%= ::BetterTogether::Geography::Settlement.human_attribute_name(:country) %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: 'better_together/geography/settlements/settlement', collection: @geography_settlements %>
        </tbody>
      </table>
    </div>
  </div>

  <% if policy(::BetterTogether::Geography::Settlement.new).create? %>
    <%= link_to t('.new'), new_geography_settlement_path, id: 'new-settlement-btn', class: "btn btn-success mt-3" %>
  <% end %>
</div>

