<%# locals: (panel:, zone:) -%>
<% if panel.data? && panel.stale? %>
  <div id="weather-stale-notice" class="alert alert-warning" role="status">
    <%= t('better_together.weather.panel.stale',
          time: panel.last_updated ? weather_datetime(panel.last_updated, zone) : t('better_together.weather.panel.never')) %>
  </div>
<% end %>
<% if panel.source_error? %>
  <div id="weather-source-error" class="alert alert-warning" role="status">
    <%= t('better_together.weather.panel.source_error') %>
  </div>
<% end %>
