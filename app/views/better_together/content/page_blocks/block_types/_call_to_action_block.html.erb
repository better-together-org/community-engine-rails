<%= link_to new_page_page_block_path(page, block_type: block_type.model_name.to_s),
            class: 'd-flex flex-column align-items-center text-decoration-none',
            data: { turbo_stream: true },
            'aria-label': t('better_together.content.block_picker.create_for_page', block: block_type.model_name.human) do %>
  <div class="fa-stack fa-3x mb-3" role="img" aria-label="<%= t('better_together.content.block_picker.icon', block: block_type.model_name.human) %>">
    <!-- Background icon (gray) -->
    <i class="fas fa-square fa-stack-2x text-light"></i>
    <!-- Foreground icon (black) -->
    <i class="fas fa-bullhorn fa-stack-1x text-dark"></i>
  </div>
  <h5 class="text-center">
    <span aria-hidden="true"><%= block_type.model_name.human %></span>
  </h5>
<% end %>
