<div class="fa-stack fa-3x mb-3" role="img" aria-label="<%= t('better_together.content.block_picker.icon', block: block_type.model_name.human) %>">
  <!-- Background icon (gray) -->
  <i class="fas fa-square fa-stack-2x text-light"></i>
  <!-- Foreground icon (black) -->
  <i class="fas fa-exclamation-triangle fa-stack-1x text-dark"></i>
</div>

<!-- Heading serves as additional label for screen readers -->
<h5 class="text-center">
  <span aria-hidden="true"><%= block_type.model_name.human %></span>
</h5>
