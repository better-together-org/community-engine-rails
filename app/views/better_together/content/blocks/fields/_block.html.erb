<%- scope = local_assigns[:scope] ? local_assigns[:scope] : BetterTogether::Content::Block.block_name %>
<%- temp_id = block.persisted? ? block.id : SecureRandom.uuid %>

<!-- Nested Block fields -->
<div id="<%= dom_id(block, temp_id) %>" class="block-fields <%= dom_class(block) %>">
  <!-- Hidden field for Block ID -->
  <%= hidden_field_tag "#{scope}[id]", block.id %>
  <%= hidden_field_tag "#{scope}[type]", block.class.name %>
  <%= hidden_field_tag "#{scope}[creator_id]", current_person&.id %>

  <%# Identifier + Privacy: both columns are available on every block type %>
  <%- block_platform = block.try(:platform) %>
  <%- block_privacy_ceiling = max_allowed_privacy(platform: block_platform, community: nil) %>
  <div class="row mb-3">
    <div class="col-12 col-md-6">
      <%= label_tag "#{scope}[identifier]", BetterTogether::Content::Block.human_attribute_name(:identifier), class: 'form-label' %>
      <%= text_field_tag "#{scope}[identifier]", block.identifier,
                         class: "form-control#{' is-invalid' if block.errors[:identifier].any?}",
                         maxlength: 100,
                         placeholder: t('better_together.content.blocks.fields.block.identifier_placeholder') %>

      <% if block.errors[:identifier].any? %>
        <div class="invalid-feedback">
          <%= block.errors[:identifier].join(", ") %>
        </div>
      <% end %>
      <small class="form-text text-muted mt-2"><%= t('better_together.content.blocks.fields.block.identifier_hint') %></small>
    </div>

    <div class="col-12 col-md-6">
      <%= fields_for scope, block, include_id: false do |block_form| %>
        <%= block_form.label :privacy, class: 'form-label' %>
        <%= privacy_field(form: block_form, klass: block.class, max_privacy: block_privacy_ceiling,
                          html_options: { class: ('is-invalid' if block.errors[:privacy].any?) }) %>
      <% end %>

      <% if block.errors[:privacy].any? %>
        <div class="invalid-feedback d-block">
          <%= block.errors[:privacy].join(", ") %>
        </div>
      <% end %>
      <% if (privacy_hint = privacy_constraint_hint(platform: block_platform, community: nil)) %>
        <small class="form-text text-muted mt-2"><%= privacy_hint %></small>
      <% else %>
        <small class="form-text text-muted mt-2"><%= t('better_together.content.blocks.fields.block.privacy_hint') %></small>
      <% end %>
    </div>
  </div>

  <%= render partial: 'better_together/content/blocks/fields/shared/style', locals: { block:, scope:, temp_id: } unless block.general_styling_enabled == 'false' %>

  <!-- Render the block's specific fields -->
  <%= render partial: "better_together/content/blocks/fields/#{block.block_name}", locals: { block:, scope:, temp_id: } %>
  <%= render partial: 'better_together/content/blocks/fields/shared/extra_block_fields', locals: { block:, scope:, temp_id: } %>
</div>
