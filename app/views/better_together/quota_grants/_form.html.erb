<%
  quota_type_options = BetterTogether::Quotas::Type.keys.map { |key| [key.titleize, key] }
%>

<%= form_with model: [platform, quota_grant], local: true do |form| %>
  <%= render 'layouts/better_together/errors', object: quota_grant %>

  <% if quota_grant.persisted? %>
    <div class="mb-3">
      <label class="form-label"><%= t('better_together.quota_grants.form.owner', default: 'Owner') %></label>
      <div class="form-control-plaintext">
        <%= quota_grant.owner_type.demodulize %>: <%= quota_grant.owner.respond_to?(:select_option_title) ? quota_grant.owner.select_option_title : quota_grant.owner.name %>
      </div>
    </div>
  <% else %>
    <div class="mb-3">
      <label class="form-label d-block"><%= t('better_together.quota_grants.form.owner_type', default: 'Owner type') %></label>
      <div class="form-check form-check-inline">
        <%= radio_button_tag 'quota_grant[owner_type]', 'BetterTogether::Person', quota_grant.owner_type == 'BetterTogether::Person', class: 'form-check-input' %>
        <%= label_tag 'quota_grant_owner_type_person', t('better_together.quota_grants.form.owner_type_person', default: 'Person'), class: 'form-check-label' %>
      </div>
      <div class="form-check form-check-inline">
        <%= radio_button_tag 'quota_grant[owner_type]', 'BetterTogether::Community', quota_grant.owner_type == 'BetterTogether::Community', class: 'form-check-input' %>
        <%= label_tag 'quota_grant_owner_type_community', t('better_together.quota_grants.form.owner_type_community', default: 'Community'), class: 'form-check-label' %>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :owner_id,
                     t('better_together.quota_grants.form.person', default: 'Person (if owner type is Person)'),
                     class: 'form-label' %>
      <%= select_tag 'quota_grant[owner_id]',
                     quota_grant.owner.is_a?(::BetterTogether::Person) ? options_for_select([[quota_grant.owner.select_option_title, quota_grant.owner_id]]) : '',
                     prompt: t('better_together.quota_grants.form.person_prompt', default: 'Search for a person'),
                     class: 'form-select mb-2',
                     data: {
                       controller: 'better_together--slim-select',
                       'better_together--slim-select-options-value': {
                         ajax: { url: available_people_platform_path(platform) },
                         settings: {
                           searchPlaceholder: t('better_together.quota_grants.form.person_prompt', default: 'Search for a person'),
                           searchHighlight: true,
                           closeOnSelect: true,
                           allowDeselect: true,
                           openPosition: 'down'
                         }
                       }.to_json
                     } %>

      <%= form.label :owner_id,
                     t('better_together.quota_grants.form.community', default: 'Community (if owner type is Community)'),
                     class: 'form-label' %>
      <%
        # Community#name is Mobility-translated, not a real column - .order(:name) would
        # fail at the SQL level, so sort in-memory instead.
        sorted_communities = BetterTogether::Community.all.sort_by { |community| community.name.to_s }
      %>
      <%= select_tag 'quota_grant[owner_id]',
                     options_from_collection_for_select(sorted_communities, :id, :name, quota_grant.owner.is_a?(::BetterTogether::Community) ? quota_grant.owner_id : nil),
                     prompt: t('better_together.quota_grants.form.community_prompt', default: 'Select a community'),
                     class: 'form-select' %>
      <div class="form-text"><%= t('better_together.quota_grants.form.owner_hint', default: 'Only the field matching the owner type above is used.') %></div>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-6">
      <%= form.label :quota_type,
                     t('better_together.quota_grants.form.quota_type', default: 'Quota type'),
                     class: 'form-label' %>
      <%= form.select :quota_type,
                      options_for_select(quota_type_options, quota_grant.quota_type),
                      {},
                      class: 'form-select', required: true, disabled: quota_grant.persisted? %>
    </div>

    <div class="col-md-6">
      <%= form.label :limit,
                     t('better_together.quota_grants.form.limit', default: 'Limit'),
                     class: 'form-label' %>
      <%= form.number_field :limit, class: 'form-control', required: true, min: 0 %>
    </div>
  </div>

  <div class="row g-3 mt-1">
    <div class="col-md-6">
      <%= form.label :expires_at,
                     t('better_together.quota_grants.form.expires_at', default: 'Expires at'),
                     class: 'form-label' %>
      <%= form.datetime_local_field :expires_at, class: 'form-control' %>
      <div class="form-text"><%= t('better_together.quota_grants.form.expires_at_hint', default: 'Leave blank for a grant that never expires.') %></div>
    </div>
  </div>

  <div class="mt-3">
    <%= form.label :reason,
                   t('better_together.quota_grants.form.reason', default: 'Reason'),
                   class: 'form-label' %>
    <%= form.text_area :reason, rows: 4, class: 'form-control' %>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: 'btn btn-primary' %>
    <%= link_to t('globals.cancel', default: 'Cancel'),
                platform_quota_grants_path(platform),
                class: 'btn btn-outline-secondary' %>
  </div>
<% end %>
