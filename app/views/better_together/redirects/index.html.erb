<% content_for :page_title do %>
  <%= t('.title') %>
<% end %>

<div class="container my-3">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
      <h1><%= t('.title') %></h1>
      <p class="text-muted mb-0"><%= t('.subtitle', platform_name: @platform.name) %></p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to t('.import_btn'), import_platform_redirects_path(@platform), id: 'import-redirects-btn', class: 'btn btn-outline-primary' %>
      <%= link_to new_platform_redirect_path(@platform), id: 'new-redirect-btn', class: 'btn btn-primary' do %>
        <i class="fas fa-plus" aria-hidden="true"></i> <%= t('.new_btn') %>
      <% end %>
    </div>
  </div>

  <%= form_with url: platform_redirects_path(@platform), method: :get, id: 'redirects-search-form', class: 'row g-2 mb-3' do %>
    <div class="col-sm-8 col-md-6">
      <%= label_tag :redirects_search_q, t('.search_label'), class: 'visually-hidden' %>
      <%= search_field_tag :q, params[:q], id: 'redirects_search_q', class: 'form-control', placeholder: t('.search_placeholder') %>
    </div>
    <div class="col-auto">
      <%= submit_tag t('.search_btn'), id: 'redirects-search-btn', name: nil, class: 'btn btn-outline-secondary' %>
    </div>
  <% end %>

  <% if @redirects.any? %>
    <div class="table-responsive">
      <table id="redirects-table" class="table table-hover" aria-label="<%= t('.table_aria') %>">
        <thead class="table-light">
          <tr>
            <th scope="col"><%= t('.header_from') %></th>
            <th scope="col"><%= t('.header_to') %></th>
            <th scope="col"><%= t('.header_status') %></th>
            <th scope="col"><%= t('.header_hits') %></th>
            <th scope="col"><span class="visually-hidden"><%= t('.header_actions') %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @redirects.each do |redirect| %>
            <tr id="<%= dom_id(redirect) %>" class="redirect-row">
              <td><code class="redirect-from-path"><%= redirect.from_path %></code></td>
              <td>
                <% if redirect.gone? %>
                  <span class="text-muted redirect-gone-label"><%= t('.gone_label') %></span>
                <% else %>
                  <code class="redirect-to-path"><%= redirect.to_path %></code>
                <% end %>
              </td>
              <td>
                <span class="badge redirect-status-badge <%= redirect.active? ? 'bg-secondary' : 'bg-light text-dark border' %>">
                  <%= redirect.status %><%= " (#{t('.inactive_label')})" unless redirect.active? %>
                </span>
              </td>
              <td class="redirect-hit-count"><%= redirect.hit_count %></td>
              <td class="text-end">
                <div id="<%= dom_id(redirect, :actions) %>" class="btn-group btn-group-sm" role="group">
                  <%= link_to t('.edit_btn'), edit_platform_redirect_path(@platform, redirect), class: 'btn btn-outline-secondary btn-sm' %>
                  <%= button_to t('.delete_btn'), platform_redirect_path(@platform, redirect), method: :delete,
                                class: 'btn btn-outline-danger btn-sm', data: { turbo_confirm: t('.delete_confirm') } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= paginate @redirects if respond_to?(:paginate) %>
  <% else %>
    <div class="alert alert-info" id="no-redirects-message"><%= t('.no_redirects') %></div>
  <% end %>

  <div class="mt-3">
    <%= link_to t('.back_to_platform'), platform_path(@platform), class: 'btn btn-outline-secondary' %>
  </div>
</div>
