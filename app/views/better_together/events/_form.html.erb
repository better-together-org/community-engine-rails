<%= form_with(model: event, class: 'form', multipart: true, id: dom_id(event, 'form'), local: true, data: { 
  controller: "better_together--form-validation better_together--tabs better-together--event-hosts", 
  'better-together--event-hosts-available-hosts-url-value': available_hosts_events_path,
  'better-together--event-hosts-select-placeholder-text': t('better_together.events.hosts.select_placeholder'),
  'better-together--event-hosts-loading-text': t('better_together.events.hosts.loading'),
  'better-together--event-hosts-error-loading-text': t('better_together.events.hosts.error_loading'),
  'better-together--event-hosts-cannot-remove-last-text': t('better_together.events.hosts.cannot_remove_last_host'),
  'better-together--event-hosts-host-removed-text': t('better_together.events.hosts.host_removed')
}) do |form| %>
  <%= form.hidden_field :creator_id, value: current_person&.id unless form.object.creator_id %>

  <% content_for :resource_toolbar do %>
    <div class="btn-toolbar mb-3" role="toolbar" aria-label="<%= t('helpers.toolbar.aria_label') %>">
      <div class="btn-group me-2" role="group">
        <%= link_to t('better_together.events.back_to_events'), events_path, class: 'btn btn-secondary' %>
      </div>
      <div class="btn-group me-2" role="group">
        <%= form.submit t('better_together.events.save_event'), class: 'btn btn-primary' %>
      </div>
      <% if event.persisted? %>
        <div class="btn-group me-2" role="group">
          <%= link_to t('better_together.events.view_event'), event, class: 'btn btn-info' %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= yield :resource_toolbar %>

  <%
    # turbo_frame_tag 'form_errors' below is nested content, not empty:
    # Turbo Drive intercepts this form's submit despite local: true, and the
    # controller's turbo_stream failure response (ResourceController#create/
    # #update) issues turbo_stream.update('form_errors', ...) which overwrites
    # whatever is inside this frame with the shared errors partial — so in
    # that path our own content here is replaced, not duplicated. This inline
    # render only actually shows for the plain format.html fallback (Turbo
    # disabled / no JS), where that turbo_stream update never runs and the
    # frame would otherwise stay empty with no visible feedback at all.
    inline_handled_attributes = %i[privacy status location]
    general_errors = event.errors.reject { |error| inline_handled_attributes.include?(error.attribute) }.map(&:full_message)
  %>
  <%= turbo_frame_tag 'form_errors' do %>
    <% if general_errors.any? %>
      <div class="alert alert-danger" role="alert" id="event-form-errors">
        <h4 class="alert-heading"><%= t('better_together.events.form_errors_heading', default: 'The following errors occurred:') %></h4>
        <ul class="mb-0">
          <% general_errors.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <div class="row">
    <!-- Vertical Pills Navigation -->
    <div class="col-md-3">
      <div class="nav flex-column nav-pills" id="event-form-tabs" role="tablist" aria-orientation="vertical">
        <button class="nav-link active" id="event-details-tab" data-bs-toggle="pill" data-bs-target="#event-details" type="button" role="tab" aria-controls="event-details" aria-selected="true" data-better_together--tabs-target="tab">
          <%= t('better_together.events.tabs.details') %>
        </button>
        <button class="nav-link" id="event-hosts-tab" data-bs-toggle="pill" data-bs-target="#event-hosts" type="button" role="tab" aria-controls="event-hosts" aria-selected="false" data-better_together--tabs-target="tab">
          <%= t('better_together.events.tabs.hosts') %>
        </button>
        <button class="nav-link" id="event-time-and-place-tab" data-bs-toggle="pill" data-bs-target="#event-time-and-place" type="button" role="tab" aria-controls="event-time-and-place" aria-selected="false" data-better_together--tabs-target="tab">
          <%= t('better_together.events.tabs.time-and-place') %>
        </button>
        <button class="nav-link" id="event-recurrence-tab" data-bs-toggle="pill" data-bs-target="#event-recurrence" type="button" role="tab" aria-controls="event-recurrence" aria-selected="false" data-better_together--tabs-target="tab">
          <%= t('better_together.events.tabs.recurrence') %>
        </button>
        <button class="nav-link" id="event-images-tab" data-bs-toggle="pill" data-bs-target="#event-images" type="button" role="tab" aria-controls="event-images" aria-selected="false" data-better_together--tabs-target="tab">
          <%= t('better_together.events.tabs.images') %>
        </button>
      </div>
    </div>

    <!-- Tab Content -->
    <div class="col-md-9 tab-content" id="event-form-tabs-content">
      <!-- Event Details Tab -->
      <div class="nav-tab-pane tab-pane fade show active" id="event-details" role="tabpanel" aria-labelledby="event-details-tab">
        <div class="row mb-3 row-cols-1 row-cols-sm-2">
          <!-- Translatable Name Field -->
          <div class="col mb-3 pb-3 border-bottom">
            <%= render partial: 'better_together/shared/translated_string_field', locals: { model: event, form: form, attribute: 'name' } %>
          </div>

          <!-- Translatable Slug Field -->
          <div class="col mb-3 pb-3 border-bottom">
            <%= render partial: 'better_together/shared/translated_string_field', locals: { model: event, form: form, attribute: 'slug' } %>
          </div>

          <!-- Privacy Field -->
          <div class="col mb-3 pb-3 border-bottom">
            <%= form.label :privacy, t('better_together.events.labels.privacy') %>
            <% _event_platform = event.platform || Current.platform %>
            <% _max_privacy = max_allowed_privacy(platform: _event_platform, community: nil) %>
            <%= privacy_field(form:, klass: event.class, max_privacy: _max_privacy) %>
            <% if (hint = privacy_constraint_hint(platform: _event_platform, community: nil)) %>
              <small class="form-text text-muted mt-1" id="<%= dom_id(event, :privacy_hint) %>">
                <%= hint %>
              </small>
            <% end %>
            <% if event.errors[:privacy].any? %>
              <div class="invalid-feedback">
                <%= event.errors[:privacy].join(", ") %>
              </div>
            <% end %>
          </div>

          <!-- Federation Visibility Field -->
          <div class="col mb-3 pb-3 border-bottom">
            <%= federation_visibility_field(form:) %>
            <%= federation_content_grants_field(form:, record: event, connections: federation_connections_for(event)) %>
          </div>

          <!-- Status Field -->
          <div class="col mb-3 pb-3 border-bottom" id="event-status-field">
            <%= form.label :status, t('better_together.events.labels.status'), class: 'form-label' %>
            <%= form.select :status,
              options_for_select(
                resource_class.statuses.values.map { |value| [t("better_together.events.statuses.#{value}"), value] },
                event.status
              ),
              {},
              class: 'form-select', data: { controller: 'better_together--slim_select' } %>
            <small class="form-text text-muted" id="<%= dom_id(event, :status_hint) %>"><%= t('better_together.events.hints.status') %></small>
            <% if event.errors[:status].any? %>
              <div class="invalid-feedback">
                <%= event.errors[:status].join(", ") %>
              </div>
            <% end %>
          </div>

          <div class="col mb-3 pb-3 border-bottom">
            <%= required_label form, :categories %>
            <%= form.select :category_ids,
              options_from_collection_for_select(
                resource_class.category_klass.positioned.all.includes(:string_translations),
                :id, :name, event.category_ids
              ),
              { include_blank: true, multiple: true },
              class: 'form-select', data: { controller: 'better_together--slim_select' } %>
            <small class="form-text text-muted"><%= t('hints.categories.select_multiple') %></small>
          </div>

          <div class="col mb-3 pb-3 border-bottom">
            <%= required_label form, :registration_url, class: "form-label" %>
            <%= form.url_field :registration_url, class: 'form-control' %>
          </div>
        </div>

        <div class="row">
          <!-- Translatable Description Field -->
          <div class="col mb-3 pb-3 border-bottom">
            <%= render partial: 'better_together/shared/translated_rich_text_field',
                       locals: {
                         model: event,
                         form: form,
                         attribute: 'description'
                       } %>
          </div>
        </div>
      </div>

      <!-- Event Hosts Tab -->
      <div class="nav-tab-pane tab-pane fade" id="event-hosts" role="tabpanel" aria-labelledby="event-hosts-tab">
        <div class="mb-4">
          <p class="text-muted">
            <%= t('better_together.events.hosts.description') %>
          </p>
        </div>

        <div class="mb-4" data-better-together--event-hosts-target="container">
          <%= form.fields_for :event_hosts do |event_host_form| %>
            <%= render 'event_host_fields', form: event_host_form %>
          <% end %>
        </div>

        <!-- ARIA Live Region for Announcements -->
        <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-better-together--event-hosts-target="announcement"></div>

        <!-- Add Host Button and Template -->
        <template data-better-together--event-hosts-target="template">
          <%= form.fields_for :event_hosts, BetterTogether::EventHost.new, child_index: 'NEW_RECORD' do |event_host_form| %>
            <%= render 'event_host_fields', form: event_host_form %>
          <% end %>
        </template>

        <%= link_to '#add-host', 
                    class: 'btn btn-outline-primary btn-sm', 
                    data: { action: 'click->better-together--event-hosts#add' },
                    aria: { label: t('better_together.events.hosts.add_host') } do %>
          <i class="fas fa-plus" aria-hidden="true"></i> <%= t('better_together.events.hosts.add_host') %>
        <% end %>
      </div>

      <!-- Event Schedule Tab -->
      <div class="nav-tab-pane tab-pane fade" id="event-time-and-place" role="tabpanel" aria-labelledby="event-time-and-place-tab">
        <div class="mb-3">
          <%= render 'event_datetime_fields', form: form, event: event %>

          <!-- Start Location Field -->
          <div class="col-12 mb-3 pb-3 border-bottom">
            <%# form.label :location, t('better_together.events.labels.location') %>

            <%# Radio-key -> full class name, derived from the same allow-list the
                controller/policy use — never hardcoded, so the form can't drift out
                of sync with BetterTogether::Geography::Placeable.included_in_models. %>
            <% location_type_map = BetterTogether::Geography::Placeable.included_in_models.each_with_object({}) do |klass, memo|
                 memo[klass.name.demodulize.underscore] = klass.name
               end %>

            <div class="location-fields" data-controller="better_together--location-selector"
                 data-better_together--location-selector-location-type-map-value="<%= location_type_map.to_json %>">
              <%= form.fields_for :location, (event.location || event.build_location) do |location_form| %>
                <%= location_form.hidden_field :locatable_id  %>
                <%= location_form.hidden_field :locatable_type  %>

                <%= label_tag 'event_location_picker', t('better_together.events.labels.select_location'), class: 'form-label' %>

                <%# One field searches every Placeable type at once (see
                    EventsController#available_locations's mixed-search mode) and,
                    on selection, gets split back into location_id/location_type by
                    location_selector_controller#applyLocationSelection - so this
                    select is a picker UI only and is deliberately NOT the
                    LocatableLocation-bound `location_id` field itself (that's the
                    separate hidden field below); its own submitted value is
                    discarded server-side. %>
                <% current_location_key = location_type_map.each_key.find { |key| event.location&.location_type_matches?(key) } %>
                <% current_location = current_location_key && location_form.object.location %>
                <% picker_initial_option = if current_location
                                              text = current_location.respond_to?(:to_formatted_s) ? current_location.to_formatted_s : current_location.to_s
                                              value = "#{location_type_map[current_location_key]}:#{current_location.id}"
                                              [["#{text} (#{current_location.class.model_name.human})", value]]
                                            elsif event.location&.simple_location? && event.location.name.present?
                                              [[event.location.name, event.location.name]]
                                            else
                                              []
                                            end %>

                <div class="d-flex gap-2 align-items-start">
                  <%# Rails' `data: {...}` hash dasherizes every key (including
                      underscores inside a namespace segment), which corrupts a
                      Stimulus identifier like `better_together--location-selector`
                      into `better-together--location-selector` - silently breaking
                      target/action wiring with no error. slim_select_controller.js
                      defends against this for its own options-value (see its
                      connect()'s dataset/getAttribute fallback chain), but Stimulus's
                      target/action system has no such fallback - so, matching every
                      other data-*-target attribute already in this partial, these are
                      passed as literal 'data-...' string keys instead of nested under
                      `data:`. %>
                  <%= select_tag 'event_location_picker',
                      options_for_select(picker_initial_option, picker_initial_option.first&.last),
                      include_blank: true,
                      class: 'form-select',
                      id: 'event_location_picker',
                      'data-controller': 'better_together--slim-select',
                      'data-better_together--location-selector-target': 'locationSelect',
                      'data-action': 'change->better_together--location-selector#applyLocationSelection',
                      'data-better_together--slim-select-options-value': { ajax: { url: available_locations_events_path }, addable: true }.to_json %>

                  <%# Always available (Pundit/inline_creatable?-gated only) - a user
                      reaches for "+New" precisely when nothing in the search results
                      is the location they want, so visibility can't depend on having
                      already picked that type via the picker. %>
                  <% inline_creatable_klasses = location_type_map.values.map(&:constantize).select(&:inline_creatable?) %>
                  <% inline_creatable_klasses.each do |klass| %>
                    <% key = klass.name.demodulize.underscore %>
                    <% next unless policy(klass).create? %>
                    <!-- Button to create a new <%= key %> inline -->
                    <%= link_to '#', class: 'btn btn-outline-secondary btn-sm mt-1',
                        'data-action': 'click->better_together--location-selector#showNewRecord',
                        'data-location-type': key,
                        'data-better_together--location-selector-target': 'newRecordButton' do %>
                      <i class="fa-solid fa-plus"></i>
                      <span class="visually-hidden"><%= t('better_together.events.actions.create_new', model: klass.model_name.human) %></span>
                      <span aria-hidden="true"><%= t('better_together.events.actions.create_new_short', default: 'New') %></span>
                    <% end %>
                  <% end %>
                </div>

                <%= location_form.hidden_field :location_id, 'data-better_together--location-selector-target': 'locationIdField' %>
                <%= location_form.hidden_field :location_type, 'data-better_together--location-selector-target': 'locationTypeField' %>
                <%= location_form.hidden_field :name, 'data-better_together--location-selector-target': 'simpleNameField' %>

                <small class="form-text text-muted"><%= t('better_together.events.hints.select_location') %></small>

                <!-- Inline new-record fields per inline-creatable Placeable type (hidden until user clicks 'New') -->
                <% inline_creatable_klasses.each do |klass| %>
                  <% key = klass.name.demodulize.underscore %>
                  <div data-better_together--location-selector-target="newRecordBlock" data-location-type="<%= key %>"
                       style="display: none; margin-top: 0.75rem;">
                    <%= location_form.fields_for :location, klass.new do |new_form| %>
                      <%= render klass.inline_create_fields_partial, form: new_form %>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
            <% if event.errors[:location].any? %>
              <div class="invalid-feedback">
                <%= event.errors[:location].join(", ") %>
              </div>
            <% end %>
            <small class="form-text text-muted mt-2"><%= t('better_together.events.hints.location') %></small>
          </div>
        </div>
      </div>

      <!-- Event Recurrence Tab -->
      <div class="nav-tab-pane tab-pane fade" id="event-recurrence" role="tabpanel" aria-labelledby="event-recurrence-tab">
        <div class="mb-3">
          <%= render 'recurrence_fields', form: form, event: event %>
        </div>
      </div>

      <!-- Event Images Tab -->
      <div class="nav-tab-pane tab-pane fade" id="event-images" role="tabpanel" aria-labelledby="event-images-tab">
        <div class="mb-3">
          <div id="event-cover-image-fields" class="mb-3" data-controller="better_together--image-preview"
            data-image-preview-clear-value="<%= t('globals.clear') %>"
            data-image-preview-undo-clear-value="<%= t('globals.undo_clear') %>">
            <%= label_tag do %>
              <%= event.class.human_attribute_name(:cover_image) %>
              <% if event.cover_image.attached? %>
                : <%= event.cover_image.filename %>
              <% end %>
            <% end %>

            <div class="input-group">
              <%= form.file_field :cover_image, accept: acceptable_image_file_types, "data-better_together--image-preview-target" => 'input', data: { 'action' => "better_together--image-preview#preview" }, class: "form-control" %>
              <%= form.hidden_field :remove_cover_image, value: '0', "data-better_together--image-preview-target" => "deleteField" %>
              <%= button_tag t('globals.clear'), { type: 'button', class: 'btn btn-secondary', "data-better_together--image-preview-target" => "deleteButton", data: { 'action' => "better_together--image-preview#toggleDelete", 'clear-value' => t('globals.clear'), 'undo-clear-value' => t('globals.undo_clear'), 'no-image-value' => t('globals.no_image') } } %>
            </div>

            <small class="form-text text-muted"><%= t('helpers.hint.event.cover_image') %></small>

            <div class="my-3 text-center preview-target" data-better_together--image-preview-target="preview" data-image-classes="cover-image" data-url="<%= storage_proxy_url_for(event.cover_image) if event.cover_image.attached? %>">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= yield :resource_toolbar %>
<% end %>
