<div class="recurrence-fields" data-controller="better-together--recurrence"
     data-better-together--recurrence-preview-url-value="<%= recurrence_preview_events_path %>"
     data-better-together--recurrence-day-unit-label-value="<%= t('better_together.events.recurrence.units.daily') %>"
     data-better-together--recurrence-week-unit-label-value="<%= t('better_together.events.recurrence.units.weekly') %>"
     data-better-together--recurrence-month-unit-label-value="<%= t('better_together.events.recurrence.units.monthly') %>"
     data-better-together--recurrence-year-unit-label-value="<%= t('better_together.events.recurrence.units.yearly') %>"
     data-better-together--recurrence-start-weekday-value="<%= (event.starts_at || Time.current).wday %>">
  <%= form.fields_for :recurrence, (event.recurrence || event.build_recurrence) do |recurrence_form| %>
    <%= recurrence_form.hidden_field :id if event.recurrence&.persisted? %>

    <!-- Series-wide note (visible whenever a frequency is selected) -->
    <div class="mb-3" data-better-together--recurrence-target="seriesNote" aria-hidden="true" style="display: none;">
      <p class="text-muted small mb-0" id="recurrence-series-note">
        <%= t('better_together.events.recurrence.notes.applies_to_series') %>
      </p>
    </div>

    <!-- Frequency Selection -->
    <div class="mb-3">
      <%= recurrence_form.label :frequency, t('better_together.events.recurrence.labels.frequency'), class: 'form-label' %>
      <%= recurrence_form.select :frequency,
          recurrence_frequency_options,
          { prompt: t('better_together.events.recurrence.prompts.select_frequency') },
          {
            class: 'form-select',
            'aria-describedby': 'frequency-help',
            data: {
              better_together__recurrence_target: 'frequencyField',
              action: 'change->better-together--recurrence#frequencyChanged'
            }
          } %>
      <small id="frequency-help" class="form-text text-muted"><%= t('better_together.events.recurrence.hints.frequency') %></small>
    </div>

    <!-- Interval Selection -->
    <div class="mb-3">
      <%= recurrence_form.label :interval, t('better_together.events.recurrence.labels.interval'), class: 'form-label' %>
      <div class="d-flex align-items-center gap-2">
        <%= recurrence_form.number_field :interval,
            value: event.recurrence&.interval || 1,
            min: 1,
            max: 365,
            class: 'form-control',
            style: 'max-width: 6rem;',
            'aria-describedby': 'interval-help',
            data: {
              better_together__recurrence_target: 'intervalField',
              action: 'input->better-together--recurrence#fieldChanged'
            } %>
        <span data-better-together--recurrence-target="intervalUnitLabel" id="interval-unit-label" class="text-muted"></span>
      </div>
      <small id="interval-help" class="form-text text-muted"><%= t('better_together.events.recurrence.hints.interval') %></small>
    </div>

    <!-- Weekday Selection (for weekly recurrence) -->
    <div class="mb-3" data-better-together--recurrence-target="weekdaysField" aria-hidden="true" style="display: none;">
      <%= recurrence_form.label :weekdays, t('better_together.events.recurrence.labels.weekdays'), class: 'form-label' %>
      <div class="weekday-shortcuts mb-2" id="recurrence-weekday-shortcuts">
        <%= button_tag t('better_together.events.recurrence.actions.select_weekdays'), type: 'button',
            class: 'btn btn-sm btn-outline-secondary me-1',
            data: { action: 'better-together--recurrence#selectWeekdaysMonToFri' } %>
        <%= button_tag t('better_together.events.recurrence.actions.select_all'), type: 'button',
            class: 'btn btn-sm btn-outline-secondary me-1',
            data: { action: 'better-together--recurrence#selectAllWeekdays' } %>
        <%= button_tag t('better_together.events.recurrence.actions.clear'), type: 'button',
            class: 'btn btn-sm btn-outline-secondary',
            data: { action: 'better-together--recurrence#clearWeekdays' } %>
      </div>
      <div class="weekday-checkboxes">
        <%= weekday_checkboxes(recurrence_form, selected_days: BetterTogether::RecurrenceScheduleBuilder.weekday_indices_for(event.recurrence)) %>
      </div>
      <small id="weekdays-help" class="form-text text-muted"><%= t('better_together.events.recurrence.hints.weekdays') %></small>
    </div>

    <!-- End Type Selection -->
    <div class="mb-3">
      <%= recurrence_form.label :end_type, t('better_together.events.recurrence.labels.end_type'), class: 'form-label' %>
      <%= recurrence_form.select :end_type,
          recurrence_end_type_options,
          { selected: event.recurrence&.end_type || 'never' },
          {
            class: 'form-select',
            'aria-describedby': 'end-type-help',
            data: {
              better_together__recurrence_target: 'endTypeField',
              action: 'change->better-together--recurrence#endTypeChanged'
            }
          } %>
      <small id="end-type-help" class="form-text text-muted"><%= t('better_together.events.recurrence.hints.end_type') %></small>
    </div>

    <!-- Never-ends warning (visible when end_type is 'never') -->
    <div class="mb-3" data-better-together--recurrence-target="neverEndsWarning" aria-hidden="true" style="display: none;">
      <div class="alert alert-warning mb-0 py-2" id="recurrence-never-ends-warning" role="alert">
        <%= t('better_together.events.recurrence.warnings.never_ends') %>
      </div>
    </div>

    <!-- Until Date (shown when end_type is 'until') -->
    <div class="mb-3" data-better-together--recurrence-target="untilDateField" aria-hidden="true" style="display: none;">
      <%= recurrence_form.label :ends_on, t('better_together.events.recurrence.labels.ends_on'), class: 'form-label' %>
      <%= recurrence_form.date_field :ends_on,
          class: 'form-control',
          'aria-describedby': 'ends-on-help',
          min: Date.current.to_s,
          data: {
            better_together__recurrence_target: 'endsOnInput',
            action: 'change->better-together--recurrence#fieldChanged'
          } %>
      <small id="ends-on-help" class="form-text text-muted"><%= t('better_together.events.recurrence.hints.ends_on') %></small>
    </div>

    <!-- Count (shown when end_type is 'count') -->
    <div class="mb-3" data-better-together--recurrence-target="countField" aria-hidden="true" style="display: none;">
      <%= recurrence_form.label :count, t('better_together.events.recurrence.labels.count'), class: 'form-label' %>
      <%= recurrence_form.number_field :count,
          min: 1,
          max: 999,
          class: 'form-control',
          'aria-describedby': 'count-help',
          data: {
            better_together__recurrence_target: 'countInput',
            action: 'input->better-together--recurrence#fieldChanged'
          } %>
      <small id="count-help" class="form-text text-muted"><%= t('better_together.events.recurrence.hints.count') %></small>
    </div>

    <!-- Exception Dates -->
    <div class="mb-3">
      <%= recurrence_form.label :exception_dates, t('better_together.events.recurrence.labels.exception_dates'), class: 'form-label' %>
      <%= recurrence_form.text_area :exception_dates,
          value: event.recurrence&.exception_dates&.join(', '),
          class: 'form-control',
          rows: 2,
          'aria-describedby': 'exception-dates-help',
          placeholder: t('better_together.events.recurrence.placeholders.exception_dates') %>
      <small id="exception-dates-help" class="form-text text-muted"><%= t('better_together.events.recurrence.hints.exception_dates') %></small>
    </div>

    <!-- Preview Section -->
    <div class="mb-3" data-better-together--recurrence-target="preview" role="status" aria-live="polite">
      <h6><%= t('better_together.events.recurrence.labels.preview') %></h6>
      <div class="alert alert-info">
        <%= t('better_together.events.recurrence.hints.preview_placeholder') %>
      </div>
    </div>
  <% end %>
</div>
