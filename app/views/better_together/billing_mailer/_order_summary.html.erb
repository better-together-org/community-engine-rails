<%# The same summary the pages show, with inline styles for mail clients. %>
<%# Words in labels and descriptions break and amounts never do, so it wraps on a phone instead of running off the edge. %>
<% cell = 'padding: 6px 8px; border-bottom: 1px solid #dee2e6; overflow-wrap: anywhere; word-break: break-word;' %>
<% amount = 'white-space: nowrap; text-align: right;' %>
<% foot = 'padding: 3px 8px; text-align: right; overflow-wrap: anywhere; word-break: break-word;' %>
<div id="billing-summary-email" style="margin: 16px 0; padding: 0; max-width: 100%;">
<table role="presentation" id="billing-email-line-items" style="width: 100%; max-width: 100%; border-collapse: collapse; font-size: 14px;">
  <thead>
    <tr style="text-align: left; background-color: #f8f9fa;">
      <th style="<%= cell %>"><%= t('better_together.billing.orders.field_item') %></th>
      <% if summary.taxed? %><th style="<%= cell %>"><%= t('better_together.billing.orders.field_tax') %></th><% end %>
      <th style="<%= cell %>"><%= t('better_together.billing.orders.field_quantity') %></th>
      <th style="<%= cell %> <%= amount %>"><%= t('better_together.billing.orders.field_amount') %></th>
    </tr>
  </thead>
  <tbody>
    <% summary.lines.each_with_index do |line, index| %>
      <tr id="billing-email-line-<%= index %>">
        <td style="<%= cell %>"><%= line.description %></td>
        <% if summary.taxed? %>
          <td style="<%= cell %>"><%= t('better_together.billing.order_summary.taxed') if line.taxed %></td>
        <% end %>
        <td style="<%= cell %>"><%= line.quantity %></td>
        <td style="<%= cell %> <%= amount %>"><%= billing_amount(line.amount_cents, summary.currency) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot id="billing-summary-email-rows">
    <% span = summary.taxed? ? 3 : 2 %>
    <% if summary.taxed? %>
      <tr id="billing-summary-email-subtotal">
        <td colspan="<%= span %>" style="<%= foot %>"><%= t('better_together.billing.orders.field_subtotal') %></td>
        <td style="padding: 3px 8px; <%= amount %>"><%= billing_amount(summary.subtotal_cents, summary.currency) %></td>
      </tr>
      <% summary.tax_rows.each_with_index do |row, index| %>
        <tr id="billing-summary-email-tax-<%= index %>">
          <td colspan="<%= span %>" style="<%= foot %>">
            <%= t('better_together.billing.order_summary.tax_on', label: row.label, rate: row.percent, base: billing_amount(row.base_cents, summary.currency)) %>
            <% if row.included %><span style="color: #6c757d;"><%= t('better_together.billing.order_summary.included') %></span><% end %>
          </td>
          <td style="padding: 3px 8px; <%= amount %>"><%= billing_amount(row.amount_cents, summary.currency) %></td>
        </tr>
      <% end %>
    <% end %>
    <tr id="billing-summary-email-total" style="font-weight: bold;">
      <td colspan="<%= span %>" style="<%= foot %>"><%= t('better_together.billing.orders.field_total') %></td>
      <td style="padding: 3px 8px; <%= amount %>"><%= billing_amount(summary.total_cents, summary.currency) %></td>
    </tr>
  </tfoot>
</table>
<% if summary.registrations.any? %>
  <p id="billing-summary-email-registrations" style="text-align: right; color: #6c757d; font-size: 13px; margin: 8px 0 0; padding: 0 8px; overflow-wrap: anywhere; word-break: break-word;">
    <%= t('better_together.billing.order_summary.registrations') %><br>
    <% summary.registrations.each do |registration| %>
      <%= t('better_together.billing.order_summary.registration', labels: registration.labels.join(' / '), number: registration.number) %><br>
    <% end %>
  </p>
<% end %>
</div>
