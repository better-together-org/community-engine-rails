<div class="container mt-5">
  <%= render @calendar %>


  <div class="my-3 d-flex justify-content-between">
    <%= link_to "Edit this calendar", edit_calendar_path(@calendar), class: "btn btn-primary" %>
    <%= link_to "Back to calendars", calendars_path, class: "btn btn-secondary" %>
    <%= button_to "Destroy this calendar", @calendar, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" %>
  </div>

  <ul class="nav nav-tabs" id="calendarTab" role="tablist">
    <li class="nav-item" role="presentation"></li>
      <a class="nav-link active" id="monthly-tab" data-bs-toggle="tab" href="#monthly" role="tab" aria-controls="monthly" aria-selected="true">Monthly</a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link" id="weekly-tab" data-bs-toggle="tab" href="#weekly" role="tab" aria-controls="weekly" aria-selected="false">Weekly</a>
    </li>
    <li class="nav-item" role="presentation">
      <a class="nav-link" id="daily-tab" data-bs-toggle="tab" href="#daily" role="tab" aria-controls="daily" aria-selected="false">Daily</a>
    </li>
  </ul>
  <div class="tab-content" id="calendarTabContent">
    <turbo-frame class="tab-pane fade show active" id="monthly" role="tabpanel" aria-labelledby="monthly-tab">
      <%= month_calendar events: @calendar_events, attribute: :starts_at, end_attribute: :ends_at do |date, day_events| %>
        <%= render 'calendar_day_events', date: date, day_events: day_events %>
      <% end %>
    </turbo-frame>
    <turbo-frame class="tab-pane fade" id="weekly" role="tabpanel" aria-labelledby="weekly-tab">
      <%= week_calendar events: @calendar_events, attribute: :starts_at, end_attribute: :ends_at do |date, day_events| %>
        <%= render 'calendar_day_events', date: date, day_events: day_events %>
      <% end %>
    </turbo-frame>
    <turbo-frame class="tab-pane fade" id="daily" role="tabpanel" aria-labelledby="daily-tab">
      <%= calendar(number_of_days: 1, events: @calendar_events, attribute: :starts_at, end_attribute: :ends_at) do |date, day_events| %>
        <%= date %>
        <%= render 'calendar_day_events', date: date, day_events: day_events %>
      <% end %>
    </turbo-frame>
  </div>

  <div class="row mt-4" id="calendar-event-lists">
    <div class="col-md-6" id="calendar-upcoming-events">
      <h5><%= t('better_together.calendars.upcoming_events') %></h5>
      <% if @upcoming_events.any? %>
        <ul class="list-unstyled" id="calendar-upcoming-events-list">
          <% @upcoming_events.each do |event| %>
            <li id="<%= dom_id(event, :upcoming) %>">
              <%= link_to event.name, better_together.event_path(event) %>
              <small class="text-muted"><%= l(event.next_occurrence_at || event.starts_at, format: :long) %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted" id="calendar-upcoming-events-empty"><%= t('better_together.calendars.no_events') %></p>
      <% end %>
    </div>
    <div class="col-md-6" id="calendar-past-events">
      <h5><%= t('better_together.calendars.past_events') %></h5>
      <% if @past_events.any? %>
        <ul class="list-unstyled" id="calendar-past-events-list">
          <% @past_events.each do |event| %>
            <li id="<%= dom_id(event, :past) %>">
              <%= link_to event.name, better_together.event_path(event) %>
              <small class="text-muted"><%= l(event.starts_at, format: :long) %></small>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted" id="calendar-past-events-empty"><%= t('better_together.calendars.no_events') %></p>
      <% end %>
    </div>
  </div>
</div>
