<div id="seed-catalog" class="container">
  <h1><%= t('seed_catalog.index.title') %></h1>
  <p class="text-muted"><%= t('seed_catalog.index.description') %></p>

  <% @catalogs.each do |catalog| %>
    <div class="card mb-4" id="seed-catalog-<%= catalog.key %>">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="h5 mb-0"><i class="fas fa-seedling me-2"></i><%= catalog.label %></h2>
          <small class="text-muted"><%= catalog.description %></small>
        </div>
        <%= button_to t('seed_catalog.index.plant_all'),
                      seed_catalog_plant_all_seeds_path(catalog_key: catalog.key),
                      method: :post,
                      id: "plant-all-#{catalog.key}-btn",
                      class: 'btn btn-primary' %>
      </div>
      <div class="card-body p-0">
        <table class="table mb-0" id="seed-catalog-<%= catalog.key %>-table">
          <thead>
            <tr>
              <th scope="col"><%= t('seed_catalog.index.category') %></th>
              <th scope="col"><%= t('seed_catalog.index.status') %></th>
              <th scope="col"><span class="visually-hidden"><%= t('seed_catalog.index.actions') %></span></th>
            </tr>
          </thead>
          <tbody>
            <% catalog.categories.each do |category| %>
              <% planted = catalog.planted?(category[:key]) %>
              <% missing_prerequisites = catalog.missing_prerequisites(category[:key]) %>
              <tr id="seed-catalog-<%= catalog.key %>-<%= category[:key] %>-row">
                <td><%= category[:label] %></td>
                <td>
                  <span class="<%= category[:key] %>-status-badge badge <%= planted ? 'bg-success' : 'bg-secondary' %>">
                    <%= planted ? t('seed_catalog.index.planted') : t('seed_catalog.index.not_planted') %>
                  </span>
                </td>
                <td class="text-end">
                  <% if missing_prerequisites.any? %>
                    <% prerequisite_labels = missing_prerequisites.map { |key| catalog.category(key)&.fetch(:label, key.to_s) }.join(', ') %>
                    <span class="text-muted small d-block mb-1"
                          id="plant-<%= category[:key] %>-missing-prerequisites">
                      <%= t('seed_catalog.index.missing_prerequisites', prerequisites: prerequisite_labels) %>
                    </span>
                  <% end %>
                  <%= button_to t('seed_catalog.index.plant'),
                                seed_catalog_plant_seeds_path(catalog_key: catalog.key, category_key: category[:key]),
                                method: :post,
                                id: "plant-#{category[:key]}-btn",
                                class: 'btn btn-outline-secondary btn-sm',
                                disabled: planted || missing_prerequisites.any?,
                                'aria-label': t('seed_catalog.index.plant_category', category: category[:label]) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
