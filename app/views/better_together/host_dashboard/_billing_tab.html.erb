<section id="host-dashboard-billing" aria-labelledby="host-dashboard-billing-title">
  <h1 id="host-dashboard-billing-title" class="h3"><%= t('host_dashboard.billing.page_title') %></h1>
  <p class="text-muted"><%= t('host_dashboard.billing.intro') %></p>

  <% billing_links = @billing_nav_item ? navigation_item_children_for(@billing_nav_item) : [] %>
  <% billing_links = billing_links.reject { |item| item.identifier == 'billing-dashboard' } %>

  <div data-controller="better_together--tabs">
    <ul id="host-dashboard-billing-nav" class="nav nav-pills flex-wrap gap-2 mb-4" role="tablist"
        aria-label="<%= t('host_dashboard.billing.nav_label') %>">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="billing-overview-tab" type="button" role="tab"
                data-bs-toggle="tab" data-bs-target="#billing-overview"
                data-better_together--tabs-target="tab"
                aria-controls="billing-overview" aria-selected="true">
          <%= t('host_dashboard.billing.overview') %>
        </button>
      </li>
      <% billing_links.each do |item| %>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="billing-tab-<%= item.identifier %>-tab" type="button" role="tab"
                  data-bs-toggle="tab" data-bs-target="#billing-pane-<%= item.identifier %>"
                  data-better_together--tabs-target="tab"
                  aria-controls="billing-pane-<%= item.identifier %>" aria-selected="false">
            <%= item.title %>
          </button>
        </li>
      <% end %>
    </ul>

    <div class="tab-content" id="host-dashboard-billing-panes">
      <div class="tab-pane fade show active" id="billing-overview" role="tabpanel"
           aria-labelledby="billing-overview-tab" tabindex="0">
        <div id="host-dashboard-billing-readiness">
          <%= render 'better_together/billing/shared/readiness', owner: host_platform, tab_ids: billing_links.map(&:identifier) %>
        </div>
      </div>

      <% billing_links.each do |item| %>
        <% path = item.route_name.present? ? public_send(item.route_name.sub(/_url\z/, '_path'), locale: I18n.locale) : item.url %>
        <%# A save that came back here asks for a particular screen of this tab (the plan just made, say). %>
        <% asked = params[:billing_path].to_s %>
        <% path = asked if asked.start_with?("#{path}/", "#{path}?") && !asked.include?('//') %>
        <div class="tab-pane fade" id="billing-pane-<%= item.identifier %>" role="tabpanel"
             aria-labelledby="billing-tab-<%= item.identifier %>-tab" tabindex="0">
          <%= turbo_frame_tag "billing-tab-#{item.identifier}", src: path, loading: :lazy, target: '_self', data: { turbo_prefetch: false } do %>
            <p class="text-muted" role="status"><%= t('host_dashboard.billing.loading') %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
