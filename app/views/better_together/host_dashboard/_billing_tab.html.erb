<section id="host-dashboard-billing" aria-labelledby="host-dashboard-billing-title">
  <h1 id="host-dashboard-billing-title" class="h3"><%= t('host_dashboard.billing.page_title') %></h1>
  <p class="text-muted"><%= t('host_dashboard.billing.intro') %></p>

  <% billing_links = @billing_nav_item ? navigation_item_children_for(@billing_nav_item) : [] %>
  <% if billing_links.any? %>
    <nav aria-label="<%= t('host_dashboard.billing.nav_label') %>">
      <ul id="host-dashboard-billing-nav" class="nav nav-pills flex-wrap gap-2 mb-4">
        <% billing_links.each do |item| %>
          <li class="nav-item">
            <%= link_to item.title, item.url, class: 'nav-link', target: '_top' %>
          </li>
        <% end %>
      </ul>
    </nav>
  <% end %>

  <div id="host-dashboard-billing-readiness" class="card">
    <div class="card-body">
      <h2 class="h5 card-title"><%= t('host_dashboard.billing.readiness_title') %></h2>
      <p class="<%= @billing_readiness.ready? ? 'text-success' : 'text-warning-emphasis' %>">
        <%= t(@billing_readiness.ready? ? 'host_dashboard.billing.ready' : 'host_dashboard.billing.not_ready') %>
      </p>
      <ul class="list-unstyled mb-0">
        <% @billing_readiness.checks.each do |check| %>
          <li class="mb-2" data-check="<%= check.key %>" data-ok="<%= check.ok %>">
            <span class="badge <%= check.ok ? 'bg-success' : 'bg-warning text-dark' %>">
              <%= t(check.ok ? 'host_dashboard.billing.done' : 'host_dashboard.billing.todo') %>
            </span>
            <%= t("host_dashboard.billing.checks.#{check.key}", purpose: check.purpose ? t("host_dashboard.billing.purposes.#{check.purpose}") : nil) %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section>
