<% content_for :page_title do %>
  <%= @resource.name %> | <%= resource_class.model_name.human.pluralize %>
<% end %>

<% set_meta_description('communities.show', community_name: @resource.name, platform_name: host_platform.name) %>

<div class="container-fluid mb-3 px-0">

  <div class="profile-header position-relative" id="<%= dom_id(@resource, :profile_header) %>">
    <%= render 'better_together/communities/header_media', community: @resource %>
  </div>

  <!-- Profile Information Section -->
  <div class="profile-info-container container">
    <div class="row align-items-end">
      <div class="col-auto">
      </div>
      <div class="col">
        <h1 class="profile-name mt-3"><%= @resource.name %></h1>
        <!-- Display the slug prefixed with @ -->
        <p class="profile-username">@<%= @resource.slug %></p>
        <%= privacy_badge(@resource) %>
      </div>
      <div class="col-auto">
        <%= render 'shared/resource_toolbar',
                   edit_path: policy(@resource).edit? ? edit_community_path(@resource) : nil,
                   edit_aria_label: t('better_together.communities.show.actions.edit_aria'),
                   destroy_path: policy(@resource).destroy? ? community_path(@resource) : nil,
                   destroy_confirm: t('partners.confirm_delete'),
                   destroy_aria_label: t('better_together.communities.show.actions.destroy_aria') do %>
          <%= render 'shared/content_actions', record: @resource %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="container mt-4">
    <!-- Membership section -->
    <hr aria-hidden="true">

    <% if @current_invitation %>
      <%= render 'better_together/shared/invitation_review', invitation: @current_invitation %>
    <% end %>

    <%= render 'better_together/shared/access_mode_panel',
               resource: @community,
               memberships: @current_person_community_memberships %>

    <% if @membership_request_review_allowed %>
      <%= render 'better_together/communities/membership_review_panel',
                 community: @community,
                 open_membership_request_count: @open_membership_request_count %>
    <% end %>

    <%# With a geocoded place the map sits beside the tabs, as on the event page. %>
    <% mapped = @resource.spaces.any? %>
    <div class="row">
    <div class="col-12 <%= 'col-lg-6 col-xl-8' if mapped %> mb-4">
    <!-- Community tabbed section with members -->
    <section class="card tabbed-section" id="community-tabbed-section" data-controller="better_together--tabs">
      <div class="card-header">
        <!-- Navigation tabs -->
        <%# Initialize the active tab state with accessible attributes %>
        <%= content_tag :div, id: 'communityTabs', class: 'nav nav-tabs card-header-tabs', role: 'tablist', aria_label: t('better_together.communities.show.sections_aria') do %>
          <%= link_to t('globals.tabs.about'), '#about', class: 'nav-link active', id: 'about-tab', data: { bs_toggle: 'tab', bs_target: '#about', turbo: false }, 'data-better_together--tabs-target' => 'tab', role: 'tab', aria: { controls: 'about', selected: 'true' }, tabindex: '0' %>
          <% if @resource.has_contact_details? %>
            <%= link_to t('globals.tabs.contact'), '#contact', class: 'nav-link', id: 'contact-tab', data: { bs_toggle: 'tab', bs_target: '#contact', turbo: false }, 'data-better_together--tabs-target' => 'tab', role: 'tab', aria: { controls: 'contact', selected: 'false' }, tabindex: '-1' %>
          <% end %>
          <% if policy(@resource).view_members? %>
            <%= link_to t('globals.tabs.members'), '#members', class: 'nav-link', id: 'members-tab', data: { bs_toggle: 'tab', bs_target: '#members', turbo: false }, 'data-better_together--tabs-target' => 'tab', role: 'tab', aria: { controls: 'members', selected: 'false' }, tabindex: '-1' %>
          <% end %>
          <% if policy(@resource).manage_roles? %>
            <%= link_to t('globals.tabs.roles_and_permissions'), '#roles-and-permissions', class: 'nav-link', id: 'roles-and-permissions-tab', data: { bs_toggle: 'tab', bs_target: '#roles-and-permissions', turbo: false }, 'data-better_together--tabs-target' => 'tab', role: 'tab', aria: { controls: 'roles-and-permissions', selected: 'false' }, tabindex: '-1' %>
          <% end %>
          <% if policy(@resource).view_quota_usage? %>
            <%= link_to t('globals.tabs.usage'), '#usage', class: 'nav-link', id: 'usage-tab', data: { bs_toggle: 'tab', bs_target: '#usage', turbo: false }, 'data-better_together--tabs-target' => 'tab', role: 'tab', aria: { controls: 'usage', selected: 'false' }, tabindex: '-1' %>
          <% end %>
          <% if @community_pages.any? %>
            <%= link_to BetterTogether::Page.model_name.human.pluralize, '#pages', class: 'nav-link', id: 'pages-tab', data: { bs_toggle: 'tab', bs_target: '#pages', turbo: false }, 'data-better_together--tabs-target' => 'tab', role: 'tab', aria: { controls: 'pages', selected: 'false' }, tabindex: '-1' %>
          <% end %>
          <%= link_to t('globals.tabs.posts'), '#posts', class: 'nav-link', id: 'posts-tab', data: { bs_toggle: 'tab', bs_target: '#posts', turbo: false }, 'data-better_together--tabs-target' => 'tab', role: 'tab', aria: { controls: 'posts', selected: 'false' }, tabindex: '-1' %>
          <%= link_to t('globals.tabs.events'), '#events', class: 'nav-link', id: 'events-tab', data: { bs_toggle: 'tab', bs_target: '#events', turbo: false }, 'data-better_together--tabs-target' => 'tab', role: 'tab', aria: { controls: 'events', selected: 'false' }, tabindex: '-1' %>
        <% end %>
      </div>

      <%# Accordion content with accessible attributes and flexbox layout %>
      <div class="card-body" id="communitySections">
        <div class="tab-content">
        <!-- Person About Section -->
        <section id="about" class="row tab-pane fade show active" role="tabpanel" aria-labelledby="about-tab">
          <div class="col-md-12">

            <!-- Description Section -->
            <div class="card-text text-muted" id="community-description">
              <%= @resource.description.presence || t('better_together.communities.show.about.no_description') %>
            </div>

            <%= render 'better_together/communities/location_line', community: @resource %>
            <%= render 'better_together/communities/about_extra', community: @resource %>

            <%= share_buttons(shareable: @resource) if @resource.privacy_public? %>
          </div>
        </section>

        <% if @resource.has_contact_details? %>
          <div id="contact" class="tab-pane fade" role="tabpanel" aria-labelledby="contact-tab">
            <%= render partial: 'better_together/contact_details/about_section', locals: { contactable: @resource, include_heading: false, include_private: policy(@resource).update? } %>
          </div>
        <% end %>

        <% if policy(@resource).view_members? %>
          <div id="members" class="tab-pane fade" role="tabpanel" aria-labelledby="members-tab">
            <%= render 'better_together/shared/invitation_panel',
              invitable: @community,
              invitation_class: BetterTogether::CommunityInvitation,
              invitation_path: better_together.community_invitations_path(community_id: @community.slug),
              available_people_path: better_together.available_people_community_invitations_path(@community.slug, format: :json),
              panel_title_key: 'better_together.invitations.community_panel.title',
              additional_fields: {
                role_id: {
                  label: t('better_together.invitations.select_role', default: 'Role'),
                  helper_method: 'role_select_field',
                  resource_type: 'BetterTogether::Community'
                }
              } %>

          <% sample_invitation = BetterTogether::CommunityInvitation.new(invitable: @community, inviter: current_person) %>
          <% if policy(sample_invitation).create? %>
            <%= render 'better_together/shared/invitations_table',
                invitations: @invitations,
                title: t('better_together.invitations.title', default: 'Invitations'),
                tbody_id: 'community_invitations_table_body',
                resend_path_proc: ->(invitation) { better_together.resend_community_invitation_path(@community, invitation) },
                destroy_path_proc: ->(invitation) { better_together.community_invitation_path(@community, invitation) } %>
          <% end %>

          <% if policy(@community.person_community_memberships.new).create? %>
            <!-- Add Member Button -->
            <div class="mb-3" data-controller="better_together--new-person-community-membership">
              <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                <i class="fas fa-user-plus"></i> <%= t('globals.add_member') %>
              </button>

              <!-- Add Member Modal -->
              <div class="modal fade" id="addMemberModal" tabindex="-1" aria-labelledby="addMemberModalLabel" data-better_together--new-person-community-membership-target="modal" data-action="turbo:submit-end->better_together--new-person-community-membership#handleSuccess">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="addMemberModalLabel"><%= t('better_together.communities.show.members.add_member_modal.title') %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('better_together.communities.show.members.add_member_modal.close') %>"></button>
                    </div>
                    <div class="modal-body">
                      <!-- Your form or other modal content here -->
                      <%= form_with model: [ @resource, ::BetterTogether::PersonCommunityMembership.new ], url: community_person_community_memberships_path(@resource.id), data: { turbo_frame: "modal_form" }, local: true do |form| %>
                        <!-- Rendering error messages here -->
                        <%= turbo_frame_tag 'form_errors' %>

                        <div class="mb-3" id="member_select">
                          <%= form.label :member_id, t('better_together.communities.show.members.add_member_modal.select_person'), class: "form-label" %>
                          <%= form.collection_select :member_id, ::BetterTogether::Person.includes(:string_translations).where.not(id: @resource.person_community_memberships.pluck(:member_id)).distinct, :id, :select_option_title, { prompt: t('better_together.communities.show.members.add_member_modal.select_person_prompt') }, { class: "form-select", required: true, data: { controller: 'better_together--slim-select' } } %>
                        </div>

                        <div class="mb-3">
                          <%= form.label :role_id, t('better_together.communities.show.members.add_member_modal.select_role'), class: "form-label" %>
                          <%= form.collection_select :role_id, ::BetterTogether::Role.includes(:string_translations).where(resource_type: @resource.class.to_s).order(:position), :id, :name, {}, { class: "form-select", required: true, data: { controller: 'better_together--slim-select' } } %>
                        </div>
                        <div class="mb-3">
                          <%= form.submit t('better_together.communities.show.members.add_member_modal.submit'), class: "btn btn-primary" %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
            <div id="members_list" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4">
              <%= render partial: 'better_together/person_community_memberships/person_community_membership_member', collection: @community_memberships, as: :membership %>
            </div>
          </div>
        <% end %>

        <% if policy(@resource).manage_roles? %>
          <div id="roles-and-permissions" class="tab-pane fade" role="tabpanel" aria-labelledby="roles-and-permissions-tab">
            <%= render 'better_together/communities/community_roles_tab',
                       community: @community,
                       community_roles: @community_roles,
                       memberships_by_role: @community_memberships_by_role %>
          </div>
        <% end %>

        <% if policy(@resource).view_quota_usage? %>
          <div id="usage" class="tab-pane fade" role="tabpanel" aria-labelledby="usage-tab">
            <%= render 'better_together/communities/quota_usage_tab', quotas: @community_quotas %>
          </div>
        <% end %>

        <% if @community_pages.any? %>
          <div id="pages" class="tab-pane fade" role="tabpanel" aria-labelledby="pages-tab">
            <div id="community_pages_list" class="mt-3 mb-4 row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4">
              <%= render partial: 'better_together/pages/page', collection: @community_pages, as: :page %>
            </div>
          </div>
        <% end %>

        <%# Posts and events: the posts and events indexes scoped to this community, loaded when the tab is first shown. %>
        <div id="posts" class="tab-pane fade" role="tabpanel" aria-labelledby="posts-tab">
          <%= turbo_frame_tag 'community-posts', src: posts_path(community_id: @community.slug, locale: I18n.locale), loading: :lazy, target: '_top' do %>
            <p class="text-muted"><%= t('better_together.communities.show.posts.loading') %></p>
          <% end %>
        </div>

        <div id="events" class="tab-pane fade" role="tabpanel" aria-labelledby="events-tab">
          <%= turbo_frame_tag 'community-events', src: events_path(community_id: @community.slug, locale: I18n.locale), loading: :lazy, target: '_top' do %>
            <p class="text-muted"><%= t('better_together.communities.show.events.loading') %></p>
          <% end %>
        </div>
        </div>
      </div>
    </section>
    </div>

    <% if mapped %>
      <section class="community-map col-12 col-lg-6 col-xl-4 pb-2 align-self-start" id="community-map" aria-label="<%= t('better_together.communities.show.map_aria', name: @resource.name) %>">
        <%= render partial: 'better_together/shared/map', locals: { map: @resource.map } %>
      </section>
    <% end %>
    </div>
  </div>
</div>
