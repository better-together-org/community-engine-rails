<%= turbo_frame_tag 'host-jobs-sidekiq', target: '_top' do %>
  <div id="host-jobs-sidekiq-embed" class="host-jobs-sidekiq-embed">
    <p class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
      <span class="text-muted"><%= t('host_dashboard.jobs.sidekiq.hint') %></span>
      <%= link_to sidekiq_web_url_for(:dashboard),
                  id: 'host-jobs-sidekiq-open-link',
                  class: 'btn btn-outline-secondary btn-sm',
                  target: '_blank',
                  rel: 'noopener',
                  data: { turbo: false } do %>
        <i class="fas fa-up-right-from-square me-1" aria-hidden="true"></i>
        <%= t('host_dashboard.jobs.sidekiq.open_new_tab') %>
        <span class="visually-hidden"><%= t('host_dashboard.jobs.sidekiq.new_tab_notice') %></span>
      <% end %>
    </p>
    <iframe id="host-jobs-sidekiq-iframe"
            name="host-jobs-sidekiq-iframe"
            class="host-jobs-sidekiq-iframe w-100 border rounded"
            src="<%= sidekiq_web_url_for(:dashboard) %>"
            title="<%= t('host_dashboard.jobs.sidekiq.iframe_title') %>"
            loading="lazy">
      <%= link_to t('host_dashboard.jobs.sidekiq.open_new_tab'), sidekiq_web_url_for(:dashboard) %>
    </iframe>
  </div>
<% end %>
