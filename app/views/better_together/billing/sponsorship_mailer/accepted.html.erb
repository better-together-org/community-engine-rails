<p><%= t('.greeting', name: @recipient&.name, default: 'Hi %{name},') %></p>

<p>
  <%= t(
        '.message',
        beneficiary_name: @beneficiary_name,
        default: '%{beneficiary_name} accepted your sponsorship offer. You can now contribute to their balance.'
      ) %>
</p>

<% if @review_url.present? %>
  <p>
    <%= link_to t('.view_sponsorship', default: 'View this sponsorship'), @review_url, class: 'text-decoration-none' %>
  </p>
<% end %>
