<% content_for :page_title do %>
  <%= t('better_together.billing.orders.sales_title') %>
<% end %>

<div id="billing-sales-page" class="container my-4">
  <h1 class="mb-2"><%= t('better_together.billing.orders.sales_title') %></h1>
  <p class="text-body-secondary mb-3"><%= t('better_together.billing.orders.sales_intro') %></p>
  <div id="billing-sales-actions" class="d-flex flex-wrap gap-2 mb-4">
    <%= link_to t('better_together.billing.offline_payments.queue_link'), billing_offline_payments_path(locale: I18n.locale),
                id: 'billing-sales-offline-queue-link', class: 'btn btn-outline-secondary' %>
    <%= link_to t('better_together.billing.walk_up.new_link'), new_billing_walk_up_sale_path(locale: I18n.locale),
                id: 'new-walk-up-sale-btn', class: 'btn btn-primary' %>
  </div>

  <% if @orders.any? %>
    <div class="card">
      <div class="table-responsive">
        <table id="billing-sales-table" class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col"><%= t('better_together.billing.orders.field_number') %></th>
              <th scope="col"><%= t('better_together.billing.orders.field_buyer') %></th>
              <th scope="col"><%= t('better_together.billing.orders.field_placed') %></th>
              <th scope="col"><%= t('better_together.billing.orders.field_status') %></th>
              <th scope="col" class="text-end"><%= t('better_together.billing.orders.field_total') %></th>
              <th scope="col"><span class="visually-hidden"><%= t('better_together.billing.plans.actions_heading') %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @orders.each do |order| %>
              <tr id="<%= dom_id(order) %>">
                <th scope="row"><code><%= order.number %></code></th>
                <td><%= order.buyer.name %></td>
                <td><%= order.placed_at ? l(order.placed_at.to_date, format: :long) : '—' %></td>
                <td><%= billing_order_status_badge(order) %></td>
                <td class="text-end"><%= billing_amount(order.total_cents, order.currency) %></td>
                <td class="text-end">
                  <%= link_to t('globals.view'), billing_sale_path(order, locale: I18n.locale), class: 'btn btn-outline-secondary btn-sm' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p id="billing-sales-empty" class="text-body-secondary"><%= t('better_together.billing.orders.no_sales') %></p>
  <% end %>
</div>
