<% content_for :page_title do %>
  <%= t('better_together.billing.refund_requests.queue_title') %>
<% end %>

<div id="billing-refund-requests-page" class="container my-4">
  <h1 class="mb-2"><%= t('better_together.billing.refund_requests.queue_title') %></h1>
  <p class="text-body-secondary mb-3"><%= t('better_together.billing.refund_requests.queue_intro') %></p>

  <ul id="billing-refund-requests-filter" class="nav nav-pills mb-3">
    <li class="nav-item">
      <%= link_to t('better_together.billing.refund_requests.all'), billing_refund_requests_path(locale: I18n.locale),
                  class: "nav-link#{' active' if params[:status].blank?}" %>
    </li>
    <% BetterTogether::Billing::RefundRequest::STATUSES.each do |status| %>
      <li class="nav-item">
        <%= link_to t("better_together.billing.refund_requests.statuses.#{status}"),
                    billing_refund_requests_path(status:, locale: I18n.locale),
                    class: "nav-link#{' active' if params[:status] == status}" %>
      </li>
    <% end %>
  </ul>

  <% if @refund_requests.any? %>
    <div class="card">
      <div class="table-responsive">
        <table id="billing-refund-requests-table" class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col"><%= t('better_together.billing.orders.field_number') %></th>
              <th scope="col"><%= t('better_together.billing.orders.field_buyer') %></th>
              <th scope="col"><%= t('better_together.billing.refund_requests.reason_label') %></th>
              <th scope="col" class="text-end"><%= t('better_together.billing.refund_requests.asked') %></th>
              <th scope="col"><%= t('better_together.billing.orders.field_status') %></th>
              <th scope="col"><span class="visually-hidden"><%= t('better_together.billing.plans.actions_heading') %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @refund_requests.each do |request| %>
              <tr id="<%= dom_id(request) %>">
                <th scope="row"><code><%= request.order.number %></code></th>
                <td><%= request.requester.name %></td>
                <td><%= t("better_together.billing.refund_requests.reasons.#{request.reason}") %></td>
                <td class="text-end"><%= request.amount_cents ? billing_amount(request.amount_cents, request.currency) : t('better_together.billing.refund_requests.everything') %></td>
                <td><span class="badge text-bg-secondary"><%= t("better_together.billing.refund_requests.statuses.#{request.status}") %></span></td>
                <td class="text-end">
                  <%= link_to t('globals.view'), billing_refund_request_path(request, locale: I18n.locale), class: 'btn btn-outline-secondary btn-sm' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div id="billing-refund-requests-pagination" class="mt-3"><%= paginate @refund_requests %></div>
  <% else %>
    <p id="billing-refund-requests-empty" class="text-body-secondary"><%= t('better_together.billing.refund_requests.none') %></p>
  <% end %>
</div>
