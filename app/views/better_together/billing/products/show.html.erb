<% content_for :page_title do %>
  <%= @product.name %> | <%= t('better_together.billing.products.index_title') %>
<% end %>

<div id="<%= dom_id(@product, :show_page) %>" class="container my-4">
  <%= render 'shared/resource_toolbar', back_to_list_path: billing_products_path(locale: I18n.locale),
                                        edit_path: policy(@product).edit? ? edit_billing_product_path(@product, locale: I18n.locale) : nil %>

  <div class="row g-4 mt-1">
    <div class="col-lg-6">
      <div id="<%= dom_id(@product, :summary_card) %>" class="card">
        <div class="card-header">
          <strong><%= @product.name %></strong>
          <span class="badge <%= @product.active? ? 'bg-success' : 'bg-secondary' %> ms-2 billing-product-status-badge">
            <%= t("better_together.billing.plans.status_#{@product.active? ? 'active' : 'inactive'}") %>
          </span>
        </div>
        <div class="card-body">
          <dl id="<%= dom_id(@product, :summary_details) %>" class="row mb-0">
            <dt class="col-sm-5"><%= t('better_together.billing.products.field_identifier') %></dt>
            <dd id="<%= dom_id(@product, :identifier) %>" class="col-sm-7"><code><%= @product.identifier %></code></dd>
            <dt class="col-sm-5"><%= t('better_together.billing.products.field_summary') %></dt>
            <dd id="<%= dom_id(@product, :summary) %>" class="col-sm-7"><%= @product.summary.presence || '—' %></dd>
            <dt class="col-sm-5"><%= t('better_together.billing.products.field_description') %></dt>
            <dd id="<%= dom_id(@product, :description) %>" class="col-sm-7"><%= @product.description.presence || '—' %></dd>
            <dt class="col-sm-5"><%= t('better_together.billing.products.field_lifetime') %></dt>
            <dd id="<%= dom_id(@product, :lifetime) %>" class="col-sm-7"><%= billing_product_lifetime(@product) %></dd>
            <dt class="col-sm-5"><%= t('better_together.billing.products.field_tax_category') %></dt>
            <dd id="<%= dom_id(@product, :tax_category) %>" class="col-sm-7"><%= @product.tax_category&.name || t('better_together.billing.products.tax_standard') %></dd>
            <dt class="col-sm-5"><%= t('better_together.billing.products.field_listed') %></dt>
            <dd id="<%= dom_id(@product, :listed) %>" class="col-sm-7"><%= t("better_together.billing.products.#{@product.listed? ? 'yes' : 'no'}") %></dd>
          </dl>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <%= render 'better_together/billing/products/prices', product: @product, manage: true %>
    </div>
  </div>

  <%= render 'better_together/billing/plans/grants', plan: @product %>
</div>
