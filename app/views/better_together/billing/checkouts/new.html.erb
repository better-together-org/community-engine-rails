<% content_for :page_title do %>
  <%= t('better_together.billing.checkout.title', plan: @plan.name) %>
<% end %>

<div id="billing-checkout-page" class="container my-4">
  <h1 class="mb-3"><%= t('better_together.billing.checkout.title', plan: @plan.name) %></h1>

  <% if @error %>
    <div class="alert alert-danger" role="alert" id="billing-checkout-error"><%= t("better_together.billing.checkout.error_#{@error}") %></div>
  <% end %>

  <%# The summary follows the billing address picker: choosing another address reloads just this frame (see billing_checkout_address_controller). %>
  <turbo-frame id="billing-checkout-tax-frame">
  <div id="billing-checkout-summary" class="card mb-4">
    <div class="card-body d-flex justify-content-between">
      <span><strong><%= @plan.name %></strong><span class="d-block text-body-secondary"><%= billing_interval_label(@plan.billing_interval) %></span></span>
      <span class="fs-5"><%= @plan.free? ? t('better_together.billing.checkout.free') : billing_amount(@plan.amount_cents, @plan.currency) %></span>
    </div>
    <% @add_ons.each do |add_on| %>
      <div class="card-body border-top d-flex justify-content-between py-2" id="<%= dom_id(add_on, :checkout_line) %>">
        <span><%= add_on.name %><span class="d-block small text-body-secondary"><%= t('better_together.billing.checkout.add_on_line') %></span></span>
        <span><%= add_on.free? ? t('better_together.billing.checkout.free') : billing_amount(add_on.amount_cents, add_on.currency) %></span>
      </div>
    <% end %>
    <% if @add_ons.any? && !@free_order %>
      <div class="card-body border-top d-flex justify-content-between py-2 fw-bold" id="billing-checkout-subtotal">
        <span><%= t('better_together.billing.checkout.subtotal') %></span>
        <span><%= billing_amount(@order_cents, @plan.currency) %></span>
      </div>
    <% end %>
    <% if @free_order %>
      <%# Nothing to tax, so no tax note. %>
    <% elsif @tax_preview&.known? && @tax_preview.taxed? %>
      <div class="card-footer">
        <%= render 'better_together/billing/order_summary', summary: @tax_preview.summary, scope: 'checkout', compact: true %>
      </div>
    <% else %>
      <div id="billing-checkout-tax-note" class="card-footer small text-body-secondary">
        <%= t(@selected_address_id == 'new' ? 'better_together.billing.checkout.tax_note_new_address' : 'better_together.billing.checkout.tax_note') %>
      </div>
    <% end %>
  </div>
  </turbo-frame>

  <%# Optional extras for this order. Ticking one reloads the page with it added; the method is chosen after. %>
  <% if @available_add_ons.any? %>
    <%= form_with(url: new_billing_checkout_path(locale: I18n.locale), method: :get, id: 'billing-checkout-add-ons-form') do %>
      <%= hidden_field_tag :plan_id, @plan.id %>
      <fieldset id="billing-checkout-add-ons" class="mb-4">
        <legend class="h5"><%= t('better_together.billing.checkout.add_ons_heading') %></legend>
        <p id="billing-checkout-add-ons-hint" class="small text-body-secondary"><%= t('better_together.billing.checkout.add_ons_hint') %></p>
        <% @available_add_ons.each do |add_on| %>
          <div class="form-check mb-2">
            <%= check_box_tag 'add_on_ids[]', add_on.id, @add_ons.include?(add_on), id: dom_id(add_on, :add_on), class: 'form-check-input',
                                                                                    'aria-describedby': 'billing-checkout-add-ons-hint' %>
            <%= label_tag dom_id(add_on, :add_on), class: 'form-check-label' do %>
              <%= add_on.name %> <span class="text-body-secondary">(<%= add_on.free? ? t('better_together.billing.checkout.free') : billing_amount(add_on.amount_cents, add_on.currency) %>)</span>
              <% if add_on.display_participant_summary.present? %>
                <span class="d-block small text-body-secondary"><%= add_on.display_participant_summary %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <%= submit_tag t('better_together.billing.checkout.update_order'), class: 'btn btn-outline-secondary', id: 'billing-checkout-add-ons-btn', name: nil %>
      </fieldset>
    <% end %>
  <% end %>

  <%# Step 1: how to pay. A method that is not available is listed with the reason. A free plan has nothing to pay. %>
  <% unless @free_order %>
  <%= form_with(url: new_billing_checkout_path(locale: I18n.locale), method: :get, id: 'billing-checkout-method-form') do %>
    <%= hidden_field_tag :plan_id, @plan.id %>
    <% @add_ons.each do |add_on| %><%= hidden_field_tag 'add_on_ids[]', add_on.id, id: dom_id(add_on, :method_form_add_on) %><% end %>
    <fieldset id="billing-checkout-methods" class="mb-4">
      <legend class="h5"><%= t('better_together.billing.checkout.how_to_pay') %></legend>
      <% @choices.each do |choice| %>
        <div class="form-check mb-2">
          <%= radio_button_tag :payment_method, choice.name, @method == choice.name, disabled: !choice.available?, class: 'form-check-input',
                                                                                    id: "billing-checkout-method-#{choice.name}" %>
          <%= label_tag "billing-checkout-method-#{choice.name}", class: 'form-check-label' do %>
            <%= billing_payment_method_label(choice.name) %>
            <% unless choice.available? %>
              <span class="d-block small text-body-secondary" id="billing-checkout-method-<%= choice.name %>-reason">
                <%= t("better_together.billing.checkout.unavailable_#{choice.reason}") %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%# Optionally pay part of it now by another way (store credit up to the balance, or cash and the like); the way chosen above takes the rest. %>
      <% if @choices.count(&:available?) > 1 %>
        <div id="billing-checkout-parts" class="mt-3 mb-3">
          <h2 class="h6"><%= t('better_together.billing.checkout.parts_heading') %></h2>
          <p id="billing-checkout-parts-hint" class="small text-body-secondary"><%= t('better_together.billing.checkout.parts_hint') %></p>
          <% @choices.select(&:available?).each do |choice| %>
            <% existing = @parts&.find { |part| part[:payment_method] == choice.name } %>
            <div class="row g-2 align-items-center mb-2">
              <%= label_tag "billing-checkout-part-#{choice.name}", billing_payment_method_label(choice.name), class: 'col-sm-4 col-form-label' %>
              <div class="col-sm-4">
                <%= text_field_tag "part_amounts[#{choice.name}]", (BetterTogether::Billing::Currency.to_major(existing[:amount_cents], @plan.currency) if existing),
                                   id: "billing-checkout-part-#{choice.name}", class: 'form-control', inputmode: 'decimal', autocomplete: 'off' %>
              </div>
              <% if choice.cap_cents %>
                <div class="col-sm-4 small text-body-secondary" id="billing-checkout-part-<%= choice.name %>-cap">
                  <%= t('better_together.billing.orders.add_payment_cap', amount: billing_amount([choice.cap_cents, @order_cents].min, @plan.currency)) %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# A subscription renews by a way the platform settles itself; the buyer picks which. %>
      <% if @purpose == 'subscription' && (renewal_choices = @choices.select(&:renewable?)).any? %>
        <div id="billing-checkout-renew-with" class="mb-3">
          <%= label_tag :renew_with, t('better_together.billing.checkout.renew_with'), class: 'form-label', for: 'billing-checkout-renew-with-select' %>
          <%= select_tag :renew_with, options_for_select([[t('better_together.billing.checkout.renew_with_default'), '']] + renewal_choices.map { |choice| [billing_payment_method_label(choice.name), choice.name] }, @renew_with),
                         id: 'billing-checkout-renew-with-select', class: 'form-select' %>
          <div id="billing-checkout-renew-with-hint" class="form-text"><%= t('better_together.billing.checkout.renew_with_hint') %></div>
        </div>
      <% end %>

      <% if @choices.none?(&:available?) %>
        <p id="billing-checkout-no-methods" class="text-body-secondary"><%= t('better_together.billing.checkout.no_methods') %></p>
      <% else %>
        <%= submit_tag t('better_together.billing.checkout.continue'), class: 'btn btn-outline-primary', id: 'billing-checkout-continue-btn', name: nil %>
      <% end %>
    </fieldset>
  <% end %>
  <% end %>

  <%# Step 2: the agreements that apply to this plan and method, accepted before anything is placed. %>
  <% if (@method || @free_order) && @gate %>
    <% if @gate.ready? %>
      <%= form_with(url: billing_checkout_path(locale: I18n.locale), method: :post, id: 'billing-checkout-form') do %>
        <%= hidden_field_tag :plan_id, @plan.id %>
        <% @add_ons.each do |add_on| %><%= hidden_field_tag 'add_on_ids[]', add_on.id, id: dom_id(add_on, :form_add_on) %><% end %>
        <%= hidden_field_tag :payment_method, @method unless @free_order %>
        <% @parts.each do |part| %>
          <%= hidden_field_tag "part_amounts[#{part[:payment_method]}]", BetterTogether::Billing::Currency.to_major(part[:amount_cents], @plan.currency), id: "billing-checkout-part-hidden-#{part[:payment_method]}" %>
        <% end %>
        <%= hidden_field_tag :renew_with, @renew_with, id: 'billing-checkout-renew-with-hidden' if @renew_with %>
        <% unless @free_order %>
          <%= render 'billing_address', addresses: @addresses, selected_id: @selected_address_id, new_address: @new_address, plan_id: @plan.id %>
        <% end %>
        <section id="billing-agreement-review" class="card mb-4" aria-labelledby="billing-agreement-review-title">
          <div class="card-header"><strong id="billing-agreement-review-title"><%= t('better_together.billing.checkout.review_title') %></strong></div>
          <div class="card-body">
            <p class="text-body-secondary"><%= t('better_together.billing.checkout.review_intro') %></p>
            <% @gate.agreements.each do |agreement| %>
              <div class="mb-3 border-bottom pb-3" id="<%= dom_id(agreement, :review) %>">
                <h2 class="h6"><%= agreement.title %></h2>
                <% summary_id = dom_id(agreement, :summary) %>
                <p class="small text-body-secondary mb-1" id="<%= summary_id %>"><%= agreement.description %></p>
                <%# The shared agreement modal (layouts/better_together/_agreement_modal_shell). The box stays locked until the buyer has read to the end. %>
                <%= link_to t('better_together.billing.checkout.view_agreement'), agreement_path(agreement, locale: I18n.locale),
                            class: 'agreement-modal-link', role: 'button', id: "billing-agreement-view-#{agreement.identifier}",
                            data: { agreement_identifier: agreement.identifier } %>
                <% if @gate.missing.include?(agreement) %>
                  <div class="form-check mt-2">
                    <%= check_box_tag agreement_acceptance_param_name(agreement), '1', false, class: 'form-check-input agreement-checkbox', required: true,
                                         data: { agreement_identifier: agreement.identifier }, aria: { describedby: summary_id, disabled: 'true' },
                                         id: "billing-agreement-accept-#{agreement.identifier}" %>
                    <%= label_tag agreement_acceptance_param_name(agreement), t('better_together.billing.checkout.accept', title: agreement.title), class: 'form-check-label',
                                for: "billing-agreement-accept-#{agreement.identifier}" %>
                  </div>
                <% else %>
                  <p class="small text-success mb-0" id="billing-agreement-accepted-<%= agreement.identifier %>"><%= t('better_together.billing.checkout.already_accepted') %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>
        <%= submit_tag t(@free_order ? 'better_together.billing.checkout.get_free' : 'better_together.billing.checkout.place_order'), class: 'btn btn-primary', id: 'billing-checkout-place-btn', name: nil %>
      <% end %>
    <% else %>
      <div class="alert alert-warning" role="alert" id="billing-checkout-not-ready"><%= t('better_together.billing.checkout.error_not_ready') %></div>
    <% end %>
  <% end %>
</div>
