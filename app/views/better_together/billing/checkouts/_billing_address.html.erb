<%# locals: (addresses:, selected_id:, new_address:, plan_id:) %>
<%# Where the buyer is billed. Tax is worked out from it, so the country and state or province must be chosen from the lists. %>
<% scope = 'better_together.billing.checkout.address' %>
<% choosing_new = selected_id == 'new' || addresses.empty? %>
<section id="billing-checkout-address" class="card mb-4" aria-labelledby="billing-checkout-address-title"
         data-controller="better_together--billing-checkout-address"
         data-better_together--billing-checkout-address-frame-id-value="billing-checkout-tax-frame"
         data-better_together--billing-checkout-address-url-value="<%= new_billing_checkout_path(locale: I18n.locale) %>"
         data-better_together--billing-checkout-address-plan-id-value="<%= plan_id %>">
  <div class="card-header"><strong id="billing-checkout-address-title"><%= t("#{scope}.title") %></strong></div>
  <div class="card-body">
    <p class="text-body-secondary" id="billing-checkout-address-hint"><%= t("#{scope}.hint") %></p>

    <div class="mb-3">
      <%= label_tag 'billing-checkout-address-select', t("#{scope}.choose"), class: 'form-label' %>
      <%= select_tag :billing_address_id,
                     options_for_select(addresses.map { |address| [address.select_option_title, address.id] } + [[t("#{scope}.new_option"), 'new']],
                                        choosing_new ? 'new' : selected_id),
                     id: 'billing-checkout-address-select', class: 'form-select',
                     'data-controller': 'better_together--slim-select',
                     'data-action': 'change->better_together--billing-checkout-address#refresh' %>
    </div>

    <%# The new address, shown whatever the select says so the page works without scripts; the server only reads it when "new" is chosen. %>
    <fieldset id="billing-checkout-new-address" class="border rounded p-3 mb-3">
      <legend class="h6 float-none w-auto px-2"><%= t("#{scope}.new_heading") %></legend>
      <%= fields_for :billing_address, new_address do |address_form| %>
        <div class="row">
          <div class="col-md-8 mb-3">
            <%= address_form.label :line1, t("#{scope}.line1"), class: 'form-label' %>
            <%= address_form.text_field :line1, class: 'form-control', id: 'billing-checkout-address-line1', autocomplete: 'address-line1' %>
          </div>
          <div class="col-md-4 mb-3">
            <%= address_form.label :postal_code, t("#{scope}.postal_code"), class: 'form-label' %>
            <%= address_form.text_field :postal_code, class: 'form-control', id: 'billing-checkout-address-postal-code', autocomplete: 'postal-code' %>
          </div>
        </div>
        <%= render 'better_together/addresses/geography_fields', form: address_form %>
      <% end %>
    </fieldset>

    <div class="form-check">
      <%= check_box_tag :make_default_billing, '1', false, class: 'form-check-input', id: 'billing-checkout-make-default' %>
      <%= label_tag 'billing-checkout-make-default', t("#{scope}.make_default"), class: 'form-check-label' %>
    </div>
  </div>
</section>
