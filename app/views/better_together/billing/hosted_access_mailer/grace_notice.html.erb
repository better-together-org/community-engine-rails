<p><%= t('.greeting', name: @recipient&.name, default: 'Hi %{name},') %></p>

<p>
  <%= t(
        '.message',
        community_name: @community_name,
        grace_period_ends_on: @grace_period_ends_on,
        default: 'Hosted access for %{community_name} will pause on %{grace_period_ends_on} unless billing is resolved.'
      ) %>
</p>

<% if @billing_url.present? %>
  <p><%= link_to t('.review_billing', default: 'Review billing'), @billing_url %></p>
<% end %>
