<%# locals: (product:, prices:) -%>
<%# Every price the item is sold at, each with its own way into checkout. Shown only when there is a real choice. %>
<% if prices.size > 1 %>
  <section id="<%= dom_id(product, :catalog_prices) %>" class="my-4">
    <h2 class="h5"><%= t('better_together.billing.catalog.choose_price') %></h2>
    <ul class="list-unstyled">
      <% prices.each do |price| %>
        <li id="<%= dom_id(price, :catalog_option) %>" class="d-flex flex-wrap align-items-center gap-3 mb-2">
          <span id="<%= dom_id(price, :catalog_option_price) %>">
            <%= render 'better_together/billing/catalog/price', plan: price %>
            <% if price.label.present? %><span class="text-body-secondary"> · <%= price.label %></span><% end %>
          </span>
          <%= link_to new_billing_checkout_path(price_id: price.id, locale: I18n.locale), id: dom_id(price, :catalog_option_buy),
                                                                                         class: 'btn btn-outline-primary btn-sm' do %>
            <%= t("better_together.billing.catalog.#{price.free? ? 'get_free' : (price.recurring? ? 'subscribe' : 'buy')}") %><span class="visually-hidden"> <%= product.name %>, <%= render 'better_together/billing/catalog/price', plan: price %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
