<section id="<%= dom_id(plan, :grants) %>" class="card mt-4" aria-labelledby="<%= dom_id(plan, :grants_title) %>">
  <div class="card-header"><h2 id="<%= dom_id(plan, :grants_title) %>" class="h5 mb-0"><%= t("better_together.billing.grants.#{plan.is_a?(BetterTogether::Billing::Product) ? 'product_title' : 'title'}") %></h2></div>
  <div class="card-body">
    <p class="text-body-secondary"><%= t("better_together.billing.grants.#{plan.is_a?(BetterTogether::Billing::Product) ? 'product_intro' : 'intro'}") %></p>

    <% if plan.included_grants.any? %>
      <ul id="<%= dom_id(plan, :grants_list) %>" class="list-group mb-4">
        <% plan.included_grants.each do |grant| %>
          <li id="<%= dom_id(grant) %>" class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= billing_grant_summary(grant) %></span>
            <% if grant.kind == 'quota_allowance' && BetterTogether::Quotas::Type.find(grant.parameters['quota_type']).unit == :bytes %>
              <%= form_with url: billing_grant_path(plan, grant, locale: I18n.locale), method: :patch, id: dom_id(grant, :edit_form),
                            class: 'd-flex gap-2 ms-auto me-2', data: { turbo_confirm: billing_grant_confirm(plan, :edit_confirm) } do %>
                <%= select_tag :amount, options_for_select(billing_storage_step_options(grant.parameters['amount']), grant.parameters['amount'].to_i),
                               id: dom_id(grant, :amount), class: 'form-select form-select-sm w-auto',
                               'aria-label': t('better_together.billing.grants.field_amount') %>
                <%= submit_tag t('globals.save'), class: 'btn btn-outline-primary btn-sm', id: dom_id(grant, :save_btn), name: nil %>
              <% end %>
            <% end %>
            <%= button_to t('better_together.billing.grants.remove'), billing_grant_path(plan, grant, locale: I18n.locale), method: :delete,
                          class: 'btn btn-outline-danger btn-sm', id: dom_id(grant, :remove_btn),
                          form: { data: { turbo_confirm: billing_grant_confirm(plan, :remove_confirm) } } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p id="<%= dom_id(plan, :grants_empty) %>" class="text-body-secondary"><%= t('better_together.billing.grants.none') %></p>
    <% end %>

    <div class="row g-4">
      <div class="col-lg-4">
        <%= form_with url: billing_grants_path(plan, locale: I18n.locale), method: :post, id: 'billing-grant-role-form',
                      data: { turbo_confirm: billing_grant_confirm(plan, :add_confirm) } do %>
          <%= hidden_field_tag :kind, 'membership_role' %>
          <h3 class="h6"><%= t('better_together.billing.grants.add_role') %></h3>
          <%= label_tag 'billing-grant-role-joinable', t('better_together.billing.grants.field_where'), class: 'form-label' %>
          <%= select_tag :joinable, options_for_select([[t('better_together.billing.grants.place_platform'), 'platform'], [t('better_together.billing.grants.place_a_community'), 'community']]),
                         id: 'billing-grant-role-joinable', class: 'form-select mb-2' %>
          <%= label_tag 'billing-grant-role-community', t('better_together.billing.grants.field_community'), class: 'form-label' %>
          <%= select_tag :community_id, options_for_select(billing_grantable_communities.map { |community| [community.name, community.id] }), include_blank: true,
                         id: 'billing-grant-role-community', class: 'form-select mb-2' %>
          <%= label_tag 'billing-grant-role-role', t('better_together.billing.grants.field_role'), class: 'form-label' %>
          <%= select_tag :role, options_for_select((billing_grantable_roles('BetterTogether::Platform') + billing_grantable_roles('BetterTogether::Community')).map { |role| [role.name, role.identifier] }.uniq),
                         id: 'billing-grant-role-role', class: 'form-select mb-2' %>
          <div class="form-text mb-2"><%= t('better_together.billing.grants.role_hint') %></div>
          <%= submit_tag t('better_together.billing.grants.add'), class: 'btn btn-outline-primary btn-sm', id: 'billing-grant-role-btn', name: nil %>
        <% end %>
      </div>
      <div class="col-lg-4">
        <%= form_with url: billing_grants_path(plan, locale: I18n.locale), method: :post, id: 'billing-grant-feature-form',
                      data: { turbo_confirm: billing_grant_confirm(plan, :add_confirm) } do %>
          <%= hidden_field_tag :kind, 'feature_access' %>
          <h3 class="h6"><%= t('better_together.billing.grants.add_feature') %></h3>
          <%= label_tag 'billing-grant-feature-key', t('better_together.billing.grants.field_feature'), class: 'form-label' %>
          <%= select_tag :feature_key, options_for_select(BetterTogether::FeatureRegistry.keys.map { |key| [BetterTogether::FeatureRegistry.name_for(key), key] }),
                         id: 'billing-grant-feature-key', class: 'form-select mb-2' %>
          <%= label_tag 'billing-grant-feature-level', t('better_together.billing.grants.field_level'), class: 'form-label' %>
          <%= select_tag :access_level, options_for_select(BetterTogether::FeatureAccessGrant::ACCESS_LEVELS.values), id: 'billing-grant-feature-level', class: 'form-select mb-2' %>
          <%= submit_tag t('better_together.billing.grants.add'), class: 'btn btn-outline-primary btn-sm', id: 'billing-grant-feature-btn', name: nil %>
        <% end %>
      </div>
      <div class="col-lg-4">
        <% quota_types = BetterTogether::Quotas::Type.all.partition { |type| type.unit == :bytes } %>
        <% size_types, count_types = quota_types %>
        <% if size_types.any? %>
          <%# Storage is chosen from the same sizes as the platform quota defaults, and kept in bytes. %>
          <%= form_with url: billing_grants_path(plan, locale: I18n.locale), method: :post, id: 'billing-grant-storage-form', class: 'mb-4',
                        data: { turbo_confirm: billing_grant_confirm(plan, :add_confirm) } do %>
            <%= hidden_field_tag :kind, 'quota_allowance' %>
            <h3 class="h6"><%= t('better_together.billing.grants.add_storage') %></h3>
            <%= label_tag 'billing-grant-storage-type', t('better_together.billing.grants.field_storage'), class: 'form-label' %>
            <%= select_tag :quota_type, options_for_select(size_types.map { |type| [quota_type_label(type.key), type.key] }),
                           id: 'billing-grant-storage-type', class: 'form-select mb-2' %>
            <%= label_tag 'billing-grant-storage-amount', t('better_together.billing.grants.field_amount'), class: 'form-label' %>
            <%= select_tag :amount, options_for_select(BetterTogether::Quotas::Defaults::STORAGE_STEPS.map { |bytes| [quota_size_label(bytes), bytes] }),
                           id: 'billing-grant-storage-amount', class: 'form-select mb-2', required: true,
                           data: { controller: 'better_together--slim-select' } %>
            <%= submit_tag t('better_together.billing.grants.add'), class: 'btn btn-outline-primary btn-sm', id: 'billing-grant-storage-btn', name: nil %>
          <% end %>
        <% end %>
        <% if count_types.any? %>
          <%= form_with url: billing_grants_path(plan, locale: I18n.locale), method: :post, id: 'billing-grant-quota-form',
                        data: { turbo_confirm: billing_grant_confirm(plan, :add_confirm) } do %>
            <%= hidden_field_tag :kind, 'quota_allowance' %>
            <h3 class="h6"><%= t('better_together.billing.grants.add_quota') %></h3>
            <%= label_tag 'billing-grant-quota-type', t('better_together.billing.grants.field_quota'), class: 'form-label' %>
            <%= select_tag :quota_type, options_for_select(count_types.map { |type| ["#{quota_type_label(type.key)} (#{type.unit})", type.key] }),
                           id: 'billing-grant-quota-type', class: 'form-select mb-2' %>
            <%= label_tag 'billing-grant-quota-amount', t('better_together.billing.grants.field_amount'), class: 'form-label' %>
            <%= number_field_tag :amount, nil, id: 'billing-grant-quota-amount', class: 'form-control mb-2', min: 1, required: true %>
            <div class="form-text mb-2"><%= t('better_together.billing.grants.amount_hint') %></div>
            <%= submit_tag t('better_together.billing.grants.add'), class: 'btn btn-outline-primary btn-sm', id: 'billing-grant-quota-btn', name: nil %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>
