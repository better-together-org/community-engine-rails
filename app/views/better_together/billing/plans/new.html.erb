<% content_for :page_title do %>
  <%= t('better_together.billing.plans.new_title') %>
<% end %>

<div class="container my-4">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <%= link_to t('better_together.billing.plans.index_title'), billing_plans_path(locale: I18n.locale) %>
      </li>
      <li class="breadcrumb-item active" aria-current="page">
        <%= t('better_together.billing.plans.new_title') %>
      </li>
    </ol>
  </nav>

  <h1 class="mb-3"><%= t('better_together.billing.plans.new_title') %></h1>

  <ul id="billing-plan-mode-tabs" class="nav nav-pills mb-4" aria-label="<%= t('better_together.billing.plans.mode_heading') %>">
    <li class="nav-item">
      <%= link_to t('better_together.billing.plans.mode_create'),
                  new_billing_plan_path(locale: I18n.locale, from: params[:from]),
                  class: "nav-link #{'active' unless @plan.link_existing}",
                  id: 'billing-plan-mode-create',
                  'aria-current': (@plan.link_existing ? nil : 'page') %>
    </li>
    <li class="nav-item">
      <%= link_to t('better_together.billing.plans.mode_link'),
                  new_billing_plan_path(locale: I18n.locale, mode: 'link', from: params[:from]),
                  class: "nav-link #{'active' if @plan.link_existing}",
                  id: 'billing-plan-mode-link',
                  'aria-current': (@plan.link_existing ? 'page' : nil) %>
    </li>
  </ul>

  <%= render 'form', billing_plan: @plan %>
</div>
