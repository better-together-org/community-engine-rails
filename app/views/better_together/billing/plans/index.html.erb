<% content_for :page_title do %>
  <%= t('better_together.billing.plans.index_title') %>
<% end %>

<div id="billing-plans-index-page" class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= t('better_together.billing.plans.index_title') %></h1>
    <% if policy(BetterTogether::Billing::Plan.new).new? %>
      <%= link_to t('better_together.billing.plans.new_plan'),
                  new_billing_plan_path(locale: I18n.locale),
                  class: 'btn btn-primary',
                  id: 'new-billing-plan-btn' %>
    <% end %>
  </div>

  <%= render 'better_together/billing/shared/readiness' %>

  <% if @plans.any? %>
    <div class="card">
      <div class="table-responsive">
        <table id="billing-plans-table" class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col"><%= t('better_together.billing.plans.field_identifier') %></th>
              <th scope="col"><%= t('better_together.billing.plans.field_name') %></th>
              <th scope="col"><%= t('better_together.billing.plans.field_billing_interval') %></th>
              <th scope="col"><%= t('better_together.billing.plans.field_amount_cents') %></th>
              <th scope="col"><%= t('better_together.billing.plans.field_active') %></th>
              <th scope="col"><%= t('better_together.billing.plans.sync_status_heading') %></th>
              <th scope="col"><%= t('better_together.billing.plans.field_pricing_tier') %></th>
              <th scope="col"><span class="visually-hidden"><%= t('better_together.billing.plans.actions_heading') %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @plans.each do |plan| %>
              <tr id="<%= dom_id(plan) %>">
                <td><code><%= plan.identifier %></code></td>
                <td><%= plan.name %></td>
                <td><%= t("better_together.billing.plans.interval_#{plan.billing_interval}") %></td>
                <td><%= billing_amount(plan.amount_cents, plan.currency) %></td>
                <td>
                  <% if plan.active? %>
                    <span class="badge bg-success billing-plan-status-badge"><%= t('better_together.billing.plans.status_active') %></span>
                  <% else %>
                    <span class="badge bg-secondary billing-plan-status-badge"><%= t('better_together.billing.plans.status_inactive') %></span>
                  <% end %>
                </td>
                <td><%= billing_sync_badge(plan) %></td>
                <td>
                  <span class="badge <%= plan.solidarity_tier? ? 'bg-info text-dark' : 'bg-secondary' %>">
                    <%= t("better_together.billing.plans.pricing_tier_#{plan.pricing_tier}") %>
                  </span>
                </td>
                <td class="text-end">
                  <div id="<%= dom_id(plan, :actions) %>" class="d-flex gap-2 justify-content-end billing-plan-actions">
                    <%= link_to t('globals.view'),
                                billing_plan_path(plan, locale: I18n.locale),
                                class: 'btn btn-outline-secondary btn-sm' %>
                    <%= link_to t('globals.edit'),
                                edit_billing_plan_path(plan, locale: I18n.locale),
                                class: 'btn btn-outline-primary btn-sm' %>
                    <% unless plan.locked_field?(:active) %>
                      <%= button_to plan.active? ? t('better_together.billing.plans.toggle_deactivate') : t('better_together.billing.plans.toggle_activate'),
                                    billing_plan_path(plan, locale: I18n.locale),
                                    method: :patch,
                                    params: { billing_plan: { active: !plan.active? } },
                                    class: plan.active? ? 'btn btn-outline-warning btn-sm' : 'btn btn-outline-success btn-sm',
                                    data: { turbo_confirm: plan.active? ? t('better_together.billing.plans.deactivate_confirm') : nil } %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info">
      <%= t('better_together.billing.plans.no_plans') %>
    </div>
  <% end %>
</div>
