<% content_for :page_title do %>
  <%= t('better_together.billing.credit.title') %>
<% end %>

<div id="billing-credit-page" class="container my-4">
  <h1 class="mb-2"><%= t('better_together.billing.credit.title') %></h1>
  <p class="text-body-secondary mb-4"><%= t('better_together.billing.credit.intro', platform: billing_owner.name) %></p>

  <%= form_with url: billing_promotion_redemptions_path(locale: I18n.locale), method: :post, id: 'billing-promotion-redeem-form', class: 'card card-body mb-4' do %>
    <%= label_tag 'billing-promotion-code', t('better_together.billing.promotions.code_label'), class: 'form-label' %>
    <div class="input-group">
      <%= text_field_tag :promotion_code, nil, id: 'billing-promotion-code', class: 'form-control', autocomplete: 'off', autocapitalize: 'characters', spellcheck: false, required: true %>
      <%= submit_tag t('better_together.billing.promotions.redeem'), id: 'billing-promotion-redeem-btn', class: 'btn btn-outline-primary', name: nil %>
    </div>
    <div class="form-text"><%= t('better_together.billing.promotions.code_hint') %></div>
  <% end %>

  <% if @accounts.any? %>
    <% @accounts.each do |account| %>
      <section id="<%= dom_id(account) %>" class="card mb-4 billing-credit-account" aria-labelledby="<%= dom_id(account, :heading) %>">
        <div class="card-header d-flex justify-content-between align-items-baseline">
          <h2 id="<%= dom_id(account, :heading) %>" class="h5 mb-0"><%= account.currency %></h2>
          <span id="<%= dom_id(account, :usable) %>" class="fs-5">
            <%= t('better_together.billing.credit.usable', amount: billing_amount(account.usable_cents, account.currency)) %>
          </span>
        </div>
        <div class="table-responsive">
          <table id="<%= dom_id(account, :lots) %>" class="table mb-0 billing-credit-lots-table">
            <caption class="visually-hidden"><%= t('better_together.billing.credit.lots_caption') %></caption>
            <thead class="table-light">
              <tr>
                <th scope="col"><%= t('better_together.billing.credit.field_origin') %></th>
                <th scope="col" class="text-end"><%= t('better_together.billing.credit.field_remaining') %></th>
                <th scope="col"><%= t('better_together.billing.credit.field_expires') %></th>
                <th scope="col"><%= t('better_together.billing.credit.field_for') %></th>
              </tr>
            </thead>
            <tbody>
              <% account.lots.select { |lot| lot.remaining_cents.positive? }.sort_by { |lot| lot.expires_at || Time.zone.at(2**31) }.each do |lot| %>
                <tr id="<%= dom_id(lot) %>">
                  <th scope="row"><%= t("better_together.billing.credit.origin_#{lot.origin}") %></th>
                  <td class="text-end"><%= billing_amount(lot.remaining_cents, account.currency) %></td>
                  <td><%= billing_credit_expiry(lot) %></td>
                  <td><%= billing_credit_purposes(lot) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="card-body border-top">
          <h3 class="h6"><%= t('better_together.billing.credit.history') %></h3>
          <table id="<%= dom_id(account, :history) %>" class="table table-sm mb-0 billing-credit-history-table">
            <caption class="visually-hidden"><%= t('better_together.billing.credit.history_caption') %></caption>
            <tbody>
              <% @history.fetch(account).each do |entry| %>
                <tr id="<%= dom_id(entry) %>">
                  <td><%= l(entry.created_at.to_date, format: :long) %></td>
                  <td><%= t("better_together.billing.credit.kind_#{entry.kind}") %></td>
                  <td class="text-end"><%= billing_signed_amount(entry.amount_cents, account.currency) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  <% else %>
    <p id="billing-credit-empty" class="text-body-secondary"><%= t('better_together.billing.credit.none') %></p>
  <% end %>
</div>
