<% content_for :page_title do %>
  <%= t('better_together.billing.orders.order_number', number: @order.number) %>
<% end %>

<div id="<%= dom_id(@order, :show_page) %>" class="container my-4">
  <%= render 'shared/resource_toolbar', back_to_list_path: billing_orders_path(locale: I18n.locale), edit_path: nil %>
  <h1 class="mb-4"><%= t('better_together.billing.orders.order_number', number: @order.number) %></h1>
  <%= render 'details', order: @order %>
</div>
