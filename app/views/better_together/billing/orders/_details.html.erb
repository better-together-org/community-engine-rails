<%# One order: its state, what is on it, and its payments. Shared by the buyer's and the steward's pages. %>
<div id="<%= dom_id(order, :details) %>" class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong><%= t('better_together.billing.orders.order_number', number: order.number) %></strong>
    <%= billing_order_status_badge(order) %>
  </div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-4"><%= t('better_together.billing.orders.field_placed') %></dt>
      <dd id="<%= dom_id(order, :placed_at) %>" class="col-sm-8"><%= billing_time(order.placed_at) %></dd>

      <dt class="col-sm-4"><%= t('better_together.billing.orders.field_purpose') %></dt>
      <dd id="<%= dom_id(order, :purpose) %>" class="col-sm-8"><%= t("better_together.billing.orders.purpose_#{order.purpose}") %></dd>

      <dt class="col-sm-4"><%= t('better_together.billing.orders.field_total') %></dt>
      <dd id="<%= dom_id(order, :total) %>" class="col-sm-8"><%= billing_amount(order.total_cents, order.currency) %></dd>

      <dt class="col-sm-4"><%= t('better_together.billing.orders.field_paid') %></dt>
      <dd id="<%= dom_id(order, :paid) %>" class="col-sm-8"><%= billing_amount(order.paid_cents, order.currency) %></dd>

      <% if order.open? %>
        <dt class="col-sm-4"><%= t('better_together.billing.orders.field_balance') %></dt>
        <dd id="<%= dom_id(order, :balance) %>" class="col-sm-8"><%= billing_amount(order.balance_cents, order.currency) %></dd>
      <% end %>

      <% if order.open? && order.expires_at %>
        <dt class="col-sm-4"><%= t('better_together.billing.orders.field_expires') %></dt>
        <dd id="<%= dom_id(order, :expires_at) %>" class="col-sm-8"><%= billing_time(order.expires_at) %></dd>
      <% end %>
    </dl>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header"><strong><%= t('better_together.billing.orders.lines_heading') %></strong></div>
  <div class="card-body p-0">
    <%= render 'better_together/billing/order_summary', summary: billing_order_summary(order), scope: 'order' %>
    <%= render 'better_together/billing/orders/documents', order: order %>
  </div>
</div>

<% refunds = billing_order_refunds(order).to_a %>
<% if refunds.any? %>
  <div id="billing-order-refunds" class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong><%= t('better_together.billing.orders.refunds_heading') %></strong>
      <span id="<%= dom_id(order, :refunded) %>" class="text-body-secondary">
        <%= t('better_together.billing.orders.refunded_total', amount: billing_amount(refunds.sum(&:amount_cents), order.currency)) %>
      </span>
    </div>
    <div class="table-responsive position-relative">
      <table id="billing-order-refunds-table" class="table mb-0">
        <caption class="visually-hidden position-absolute"><%= t('better_together.billing.orders.refunds_caption', number: order.number) %></caption>
        <thead class="table-light">
          <tr>
            <th scope="col"><%= t('better_together.billing.orders.field_refund_date') %></th>
            <th scope="col"><%= t('better_together.billing.orders.field_status') %></th>
            <th scope="col" class="text-end"><%= t('better_together.billing.orders.field_amount') %></th>
          </tr>
        </thead>
        <tbody>
          <% refunds.each do |refund| %>
            <tr id="<%= dom_id(refund) %>">
              <th scope="row" class="fw-normal"><%= billing_time(refund.created_at) %></th>
              <td><%= billing_refund_status_label(refund) %></td>
              <td class="text-end">
                <%= billing_amount(refund.amount_cents, refund.currency) %>
                <% if refund.tax_cents.positive? %>
                  <span class="d-block small text-body-secondary"><%= t('better_together.billing.orders.refund_includes_tax', tax: billing_amount(refund.tax_cents, refund.currency)) %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% if order.agreement_acceptances.any? %>
  <div class="card mb-4">
    <div class="card-header"><strong><%= t('better_together.billing.orders.agreements_heading') %></strong></div>
    <ul id="billing-order-agreements" class="list-group list-group-flush">
      <% order.agreement_acceptances.each do |acceptance| %>
        <li id="<%= dom_id(acceptance) %>" class="list-group-item">
          <%= acceptance.agreement_title %>
          <span class="d-block small text-body-secondary">
            <%= t('better_together.billing.orders.accepted_by', name: acceptance.signer.name, date: billing_time_text(acceptance.accepted_at)) %>
          </span>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-header"><strong><%= t('better_together.billing.orders.payments_heading') %></strong></div>
  <% if order.payments.any? %>
    <div class="table-responsive position-relative">
      <table id="billing-order-payments" class="table mb-0">
        <caption class="visually-hidden position-absolute"><%= t('better_together.billing.tables.order_payments') %></caption>
        <thead class="table-light">
          <tr>
            <th scope="col"><%= t('better_together.billing.orders.field_method') %></th>
            <th scope="col"><%= t('better_together.billing.orders.field_status') %></th>
            <th scope="col" class="text-end"><%= t('better_together.billing.orders.field_amount') %></th>
          </tr>
        </thead>
        <tbody>
          <% order.payments.each do |payment| %>
            <tr id="<%= dom_id(payment) %>">
              <td><%= billing_payment_method_label(payment.processor) %></td>
              <td><%= t("better_together.billing.orders.payment_status_#{payment.status}") %></td>
              <td class="text-end"><%= billing_amount(payment.amount_cents, payment.currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card-body text-body-secondary" id="billing-order-no-payments"><%= t('better_together.billing.orders.no_payments') %></div>
  <% end %>
</div>
