<%# How to pay, for an order the buyer pays outside the platform (cash, a cheque, an e-transfer). %>
<%# The instructions are shown only on the buyer's own order, after the agreements were accepted when it was placed. %>
<%# An order paid in parts can have several of these, one card each; their ids end with the payment's id. %>
<% order.offline_payments.order(:created_at).each do |offline| %>
  <% next if offline.cancelled? && order.open? %>
  <% suffix = "-#{offline.id}" %>
  <div id="<%= dom_id(offline) %>" class="card mb-4 billing-offline-payment-card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong id="billing-offline-heading<%= suffix %>"><%= t('better_together.billing.offline_payments.heading', method: billing_payment_method_label(offline.processor)) %></strong>
      <%= billing_offline_status_badge(offline) %>
    </div>
    <div class="card-body">
      <p id="billing-offline-status-message<%= suffix %>" class="mb-3"><%= t("better_together.billing.offline_payments.status_message_#{offline.status}") %></p>

      <% if offline.waiting? || offline.expired? %>
        <% if offline.waiting? %>
          <% if order.tax_cents.positive? %>
            <div class="mb-3"><%= render 'better_together/billing/order_summary', summary: billing_order_summary(order), scope: "offline#{suffix}", compact: true %></div>
          <% end %>
          <h2 class="h6"><%= t('better_together.billing.offline_payments.instructions_heading') %></h2>
          <dl id="billing-offline-instructions<%= suffix %>" class="row">
            <% billing_offline_instruction_rows(offline).each do |label, value| %>
              <dt class="col-sm-4"><%= label %></dt>
              <dd class="col-sm-8"><%= simple_format(value, {}, sanitize: true) %></dd>
            <% end %>
          </dl>
          <p id="billing-offline-amount<%= suffix %>" class="fw-bold">
            <%= t('better_together.billing.offline_payments.amount_to_pay', amount: billing_amount(offline.payment.amount_cents, order.currency)) %>
            <% if order.expires_at %>
              <span class="fw-normal text-body-secondary"><%= t('better_together.billing.offline_payments.hold_until', date: l(order.expires_at, format: :long)) %></span>
            <% end %>
          </p>
        <% end %>

        <div id="billing-offline-disclosure<%= suffix %>" class="alert alert-warning" role="note">
          <strong><%= t('better_together.billing.offline_payments.disclosure_heading') %></strong>
          <ul class="mb-0">
            <% billing_offline_disclosure_keys(offline).each do |key| %>
              <li><%= t(key, hours: ((order.expires_at - order.placed_at) / 1.hour).round) %></li>
            <% end %>
          </ul>
        </div>

        <%= form_with url: billing_order_claim_path(order, locale: I18n.locale), method: :post, id: "billing-offline-claim-form#{suffix}" do %>
          <%= hidden_field_tag :offline_id, offline.id, id: "billing-offline-claim-offline#{suffix}" %>
          <p id="billing-offline-claim-hint<%= suffix %>" class="form-text">
            <%= t('better_together.billing.offline_payments.claim_hint') %>
          </p>
          <% if offline.claimed_by_buyer? %>
            <p id="billing-offline-claimed-note<%= suffix %>" class="text-success">
              <%= t('better_together.billing.offline_payments.claimed_note', date: l(offline.claimed_at, format: :long)) %>
            </p>
          <% end %>
          <div class="mb-3">
            <%= label_tag :reference, t('better_together.billing.offline_payments.reference_label'), class: 'form-label', for: "billing-offline-claim-reference#{suffix}" %>
            <%= text_field_tag :reference, nil, id: "billing-offline-claim-reference#{suffix}", class: 'form-control', maxlength: BetterTogether::Billing::OfflinePayment::REFERENCE_LIMIT,
                                                autocomplete: 'off' %>
          </div>
          <%= submit_tag t(offline.claimed_by_buyer? ? 'better_together.billing.offline_payments.claim_again' : 'better_together.billing.offline_payments.claim'),
                         id: "billing-offline-claim-btn#{suffix}", class: 'btn btn-outline-primary', data: { disable_with: false } %>
        <% end %>
      <% end %>

      <% if offline.rejected? && offline.rejection_reason.present? %>
        <p id="billing-offline-rejection-reason<%= suffix %>" class="mb-0">
          <%= t('better_together.billing.offline_payments.rejection_reason', reason: offline.rejection_reason) %>
        </p>
      <% end %>
    </div>
  </div>
<% end %>
