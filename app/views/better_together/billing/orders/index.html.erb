<% content_for :page_title do %>
  <%= t('better_together.billing.orders.index_title') %>
<% end %>

<div id="billing-orders-page" class="container my-4">
  <div class="d-flex justify-content-between align-items-start mb-4">
    <h1 class="mb-0"><%= t('better_together.billing.orders.index_title') %></h1>
    <div class="d-flex gap-2">
      <%= link_to t('better_together.billing.entitlements.title'), billing_entitlements_path(locale: I18n.locale), class: 'btn btn-outline-secondary', id: 'billing-entitlements-link' %>
      <%= link_to t('better_together.billing.subscriptions.index_title'), billing_subscriptions_path(locale: I18n.locale), class: 'btn btn-outline-secondary', id: 'billing-subscriptions-link' %>
      <%= link_to t('better_together.billing.credit.title'), billing_credit_path(locale: I18n.locale), class: 'btn btn-outline-secondary', id: 'billing-credit-link' %>
    </div>
  </div>

  <%= form_with url: billing_orders_path(locale: I18n.locale), method: :get, id: 'billing-orders-filters', class: 'row g-2 align-items-end mb-3' do %>
    <div class="col-sm-4 col-md-3">
      <%= label_tag :status, t('better_together.billing.orders.filter_status'), class: 'form-label' %>
      <%= select_tag :status, options_for_select([[t('better_together.billing.orders.filter_any'), '']] + BetterTogether::Billing::Order::STATUSES.map { |status| [t("better_together.billing.orders.status_#{status}"), status] }, @status),
                     id: 'billing-orders-filter-status', class: 'form-select' %>
    </div>
    <div class="col-sm-4 col-md-3">
      <%= label_tag :year, t('better_together.billing.orders.filter_year'), class: 'form-label' %>
      <%= select_tag :year, options_for_select([[t('better_together.billing.orders.filter_any'), '']] + @years, @year),
                     id: 'billing-orders-filter-year', class: 'form-select' %>
    </div>
    <div class="col-auto d-flex gap-2">
      <%= submit_tag t('better_together.billing.orders.filter_apply'), name: nil, id: 'billing-orders-filter-btn', class: 'btn btn-primary' %>
      <% if @status || @year %>
        <%= link_to t('better_together.billing.orders.filter_clear'), billing_orders_path(locale: I18n.locale), id: 'billing-orders-filter-clear', class: 'btn btn-outline-secondary' %>
      <% end %>
    </div>
  <% end %>

  <% if @orders.any? %>
    <div class="card">
      <div class="table-responsive">
        <table id="billing-orders-table" class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col"><%= t('better_together.billing.orders.field_number') %></th>
              <th scope="col"><%= t('better_together.billing.orders.field_placed') %></th>
              <th scope="col"><%= t('better_together.billing.orders.field_status') %></th>
              <th scope="col" class="text-end"><%= t('better_together.billing.orders.field_total') %></th>
              <th scope="col"><span class="visually-hidden"><%= t('better_together.billing.plans.actions_heading') %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @orders.each do |order| %>
              <tr id="<%= dom_id(order) %>">
                <th scope="row"><code><%= order.number %></code></th>
                <td><%= order.placed_at ? l(order.placed_at.to_date, format: :long) : '—' %></td>
                <td><%= billing_order_status_badge(order) %></td>
                <td class="text-end"><%= billing_amount(order.total_cents, order.currency) %></td>
                <td class="text-end">
                  <%= link_to t('globals.view'), billing_order_path(order, locale: I18n.locale), class: 'btn btn-outline-secondary btn-sm' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div id="billing-orders-pagination" class="mt-3"><%= paginate @orders, params: { status: @status, year: @year } %></div>
  <% else %>
    <p id="billing-orders-empty" class="text-body-secondary"><%= t(@status || @year ? 'better_together.billing.orders.no_matching_orders' : 'better_together.billing.orders.no_orders') %></p>
  <% end %>
</div>
