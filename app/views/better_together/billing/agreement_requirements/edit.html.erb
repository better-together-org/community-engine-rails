<% content_for :page_title do %>
  <%= t('better_together.billing.requirements.edit_title') %>
<% end %>

<div id="billing-agreement-requirement-edit-page" class="container my-4">
  <h1 class="mb-4"><%= t('better_together.billing.requirements.edit_title') %></h1>

  <%= render 'form', requirement: @requirement, url: billing_agreement_requirement_path(@requirement, locale: I18n.locale), method: :patch,
                     title: t('better_together.billing.requirements.edit_title'), submit_label: t('better_together.billing.requirements.save'),
                     form_id: 'billing-agreement-requirement-form', submit_id: 'billing-requirement-save-btn' %>
  <%= link_to t('better_together.billing.requirements.back'), billing_agreement_requirements_path(locale: I18n.locale), id: 'billing-requirement-back-link' %>
</div>
