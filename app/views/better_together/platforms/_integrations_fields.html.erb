<%# locals: (platform:, form:) %>
<div id="<%= dom_id(platform, 'integrations') %>">
  <p class="form-text text-muted"><%= t('better_together.platforms.form.integrations_hint') %></p>

  <% BetterTogether::PlatformSettingsRegistry.grouped.each do |group, definitions| %>
    <fieldset class="mb-4" id="<%= dom_id(platform, "integration_#{group}") %>">
      <legend class="h5"><%= definitions.first.group_label || group.humanize %></legend>

      <% definitions.each do |definition| %>
        <% field_id = "#{dom_id(platform)}_integration_#{group}_#{definition.field}" %>
        <% field_name = "platform[integration_settings][#{group}][#{definition.field}]" %>
        <% value = platform.integration_settings.dig(group, definition.field) %>
        <% source = platform.integration_setting_source(definition.key) %>
        <% hint_id = "#{field_id}_hint" %>
        <% label = definition.label || definition.field.humanize %>

        <div class="mb-3">
          <% if definition.type == :boolean %>
            <div class="form-check">
              <%= hidden_field_tag field_name, '0', id: nil %>
              <%= check_box_tag field_name, '1', platform.integration_setting(definition.key) == true,
                                id: field_id, class: 'form-check-input', aria: { describedby: hint_id } %>
              <%= label_tag field_id, label, class: 'form-check-label' %>
            </div>
          <% else %>
            <%= label_tag field_id, label, class: 'form-label' %>
            <% if definition.type == :select %>
              <%= select_tag field_name, options_for_select(definition.options, value || platform.integration_setting(definition.key)),
                             id: field_id, class: 'form-select', include_blank: true, aria: { describedby: hint_id } %>
            <% elsif definition.type == :text %>
              <%= text_area_tag field_name, value, id: field_id, rows: 4, class: 'form-control', aria: { describedby: hint_id } %>
            <% elsif definition.secret %>
              <%= password_field_tag field_name, nil, id: field_id, class: 'form-control', autocomplete: 'off',
                                     aria: { describedby: hint_id } %>
            <% else %>
              <%= text_field_tag field_name, value, id: field_id, class: 'form-control',
                                 placeholder: (platform.integration_setting(definition.key) if source == :env && !definition.secret),
                                 aria: { describedby: hint_id } %>
            <% end %>
          <% end %>

          <div class="form-text text-muted" id="<%= hint_id %>">
            <%= definition.hint %>
            <% if definition.secret && value.present? %>
              <%= t('better_together.platforms.form.integrations_secret_set') %>
            <% end %>
            <% if source == :env %>
              <span id="<%= field_id %>_env_note"><%= t('better_together.platforms.form.integrations_env_fallback', variable: definition.env_fallback) %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </fieldset>
  <% end %>
</div>

<% if policy(BetterTogether::PlatformSnippet.new(platform:)).index? %>
  <section class="mb-4" id="<%= dom_id(platform, 'custom_code') %>">
    <h2 class="h5"><%= t('better_together.platforms.form.custom_code_title') %></h2>
    <p class="form-text text-muted"><%= t('better_together.platforms.form.custom_code_hint') %></p>
    <%= link_to t('better_together.platforms.form.custom_code_link'), platform_platform_snippets_path(platform),
                id: "#{dom_id(platform)}_custom_code_link", class: 'btn btn-outline-secondary' %>
  </section>
<% end %>
