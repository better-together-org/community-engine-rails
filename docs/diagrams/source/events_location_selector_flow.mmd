flowchart TD

  %% Location Selector Stimulus Controller
  START[Event Form Load] --> INIT["Location Selector Stimulus Controller\nconnect()"]
  INIT --> DISABLE["Disable every '+New' block's fields\n(hidden but not disabled still POSTs)"]

  %% Search
  DISABLE --> USER[Organizer types in the mixed-search picker]
  USER --> DEBOUNCE["slim_select_controller debounces\nthe AJAX fetch (300ms)"]
  DEBOUNCE --> SEARCH["GET /events/available_locations?search=..."]
  SEARCH --> BACKEND["EventsController#available_locations\n(no location_type given)"]
  BACKEND --> MIXED["mixed_location_options:\nsearches every Placeable type at once"]
  MIXED --> SCOPES{Per type}
  SCOPES -->|Address / Building| POLICY["Policy-scoped:\norganizer's own + public records"]
  SCOPES -->|Settlement / Region| CURATED[Unscoped: full curated reference list]
  SCOPES -->|Floor / Room| INHERITED[Scoped via their building's visibility]
  POLICY --> RESULTS
  CURATED --> RESULTS
  INHERITED --> RESULTS["Composite 'ClassName:id' results,\ncapped per type, type-labeled"]

  %% Selection
  RESULTS --> CHOICE{Organizer's choice}
  CHOICE -->|Picks a result| SPLIT["applyLocationSelection:\nmatch composite value's class-name prefix"]
  CHOICE -->|"Types free text, no match\n(SlimSelect 'addable')"| SIMPLE["setSimpleLocation:\nwrite hidden name field"]
  CHOICE -->|"Clicks '+New'\n(Address/Building only, always visible)"| NEWRECORD[Show inline new-record panel,\nenable its fields]

  SPLIT --> STRUCTURED["setStructuredLocation:\nwrite hidden location_id/location_type,\nclear simple name field"]
  STRUCTURED --> CLOSEBLOCKS["closeAllNewRecordBlocks:\nany open '+New' panel closes + disables"]
  SIMPLE --> CLOSEBLOCKS
  NEWRECORD --> FILL["Fill inline fields:\nline1, city, postal_code, etc."]

  %% Submission & backend
  CLOSEBLOCKS --> SUBMIT[Submit Event Form]
  FILL --> SUBMIT

  SUBMIT --> LOCATTR{Which fields are populated?}
  LOCATTR -->|"location_id + location_type\n(plain polymorphic FK columns)"| DIRECT["Ordinary Rails mass assignment\n(no custom setter involved)"]
  LOCATTR -->|name only| DIRECT
  LOCATTR -->|"Nested location_attributes\n(the '+New' panel's own fields)"| CUSTOM["LocatableLocation#location_attributes=\n(custom setter, '+New' path only)"]
  CUSTOM --> BUILD["klass.locatable_location_build(attrs):\nbuilds the new Address/Building"]

  DIRECT --> SAVE["belongs_to :location, autosave: true"]
  BUILD --> SAVE
  SAVE --> GEOCODE{Needs geocoding?}
  GEOCODE -->|"Yes: this save changed something,\nor not yet geocoded"| GEOJOB[Schedule geocoding job]
  GEOCODE -->|No| SUCCESS[Event + location saved together]
  GEOJOB --> SUCCESS

  %% CSS Classes for Visual Distinction
  classDef stimulus fill:#e3f2fd
  classDef backend fill:#e8f5e8
  classDef data fill:#fff3e0

  class INIT,DISABLE,DEBOUNCE,SPLIT,STRUCTURED,SIMPLE,CLOSEBLOCKS,NEWRECORD stimulus
  class BACKEND,MIXED,POLICY,CURATED,INHERITED,DIRECT,CUSTOM,BUILD,GEOJOB backend
  class RESULTS,FILL,SAVE data
