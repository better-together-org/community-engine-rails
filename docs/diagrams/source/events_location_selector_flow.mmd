flowchart TD

  %% Location Selector Stimulus Controller
  START[Event Form Load] --> INIT["Location Selector Stimulus Controller\nconnect()"]
  INIT --> DISABLE["Disable the inline address panel's fields\n(hidden but not disabled still POSTs),\nunless the server re-rendered it open"]

  %% Search
  DISABLE --> USER[Organizer types in the mixed-search picker]
  USER --> DEBOUNCE["slim_select_controller debounces\nthe AJAX fetch (300ms)"]
  DEBOUNCE --> SEARCH["GET /events/available_locations?search=..."]
  SEARCH --> BACKEND["EventsController#available_locations\n(no location_type given)"]
  BACKEND --> MIXED["mixed_location_options:\nsearches every Placeable type at once"]
  MIXED --> SCOPES{Per type}
  SCOPES -->|Address / Building| POLICY["Policy-scoped:\norganizer's own + public records"]
  SCOPES -->|Settlement / Region| CURATED[Unscoped: full curated reference list]
  SCOPES -->|Floor / Room| INHERITED[Scoped via their building's visibility]
  POLICY --> RESULTS
  CURATED --> RESULTS
  INHERITED --> RESULTS["Composite ClassName:id results,\ncapped per type, type-labeled,\nplus Create-new-address and\nUse-typed-text action rows"]

  %% Selection
  RESULTS --> CHOICE{Organizer's choice}
  CHOICE -->|Picks an existing result| SPLIT["applyLocationSelection:\nmatch composite value's class-name prefix"]
  CHOICE -->|Selects the Use-typed-text row| SIMPLE["applySimpleFromQuery:\nwrite hidden name field"]
  CHOICE -->|Selects the Create-new-address row| NEWRECORD["revealNewRecord: reset the picker,\nunhide and enable the inline address\nfieldset, prefill line1, move focus"]

  SPLIT --> STRUCTURED["setStructuredLocation:\nwrite hidden location_id/location_type,\nclear simple name field"]
  STRUCTURED --> CLOSEBLOCKS["closeAllNewRecordBlocks:\nany open address panel closes and disables"]
  SIMPLE --> CLOSEBLOCKS
  NEWRECORD --> FILL["Fill inline address fields:\nline1, city, postal_code, etc."]
  NEWRECORD --> CANCEL["Cancel: hide and disable the fieldset,\nclear its inputs and the hidden fields,\nreturn focus to the combobox"]
  CANCEL --> USER

  %% Submission & backend
  CLOSEBLOCKS --> SUBMIT[Submit Event Form]
  FILL --> SUBMIT

  SUBMIT --> LOCATTR{Which fields are populated?}
  LOCATTR -->|location_id + location_type| CUSTOM
  LOCATTR -->|name only| CUSTOM
  LOCATTR -->|Nested location_attributes| CUSTOM["LocatableLocation#location_attributes=\n(id lookup, type build, or simple name)"]
  CUSTOM --> BUILD["Address.locatable_location_build(attrs):\nlooks up by id first,\nonly builds a new Address if not found"]

  CUSTOM --> SAVE["belongs_to :location, autosave: true"]
  BUILD --> SAVE
  SAVE --> GEOCODE{Needs geocoding?}
  GEOCODE -->|"Yes: this save changed something,\nor not yet geocoded"| GEOJOB[Schedule geocoding job]
  GEOCODE -->|No| SUCCESS[Event + location saved together]
  GEOJOB --> SUCCESS

  %% CSS Classes for Visual Distinction
  classDef stimulus fill:#e3f2fd
  classDef backend fill:#e8f5e8
  classDef data fill:#fff3e0

  class INIT,DISABLE,DEBOUNCE,SPLIT,STRUCTURED,SIMPLE,CLOSEBLOCKS,NEWRECORD,CANCEL stimulus
  class BACKEND,MIXED,POLICY,CURATED,INHERITED,CUSTOM,BUILD,GEOJOB backend
  class RESULTS,FILL,SAVE data
