---
title: Joatu request show decision tree (generated from the access contract)
---
flowchart TD
  start(["show joatu request"])
  start --> r0
  r0{"privacy_gate: Is the record public, or community-level and the actor signed in?"}
  r0 -- yes --> r0o(["allow"])
  class r0o out_allow
  r0 -- no --> r1
  r1{"own_record: Is the actor the creator?"}
  r1 -- yes --> r1o(["allow"])
  class r1o out_allow
  r1 -- no --> r2
  r2{"signed_in: Is the actor signed in?"}
  r2 -- yes --> r2o(["allow"])
  class r2o out_allow
  r2 -- no --> r3
  r3{"block: Has the creator blocked the actor, or the actor the creator?"}
  r3 -- yes --> r3o(["deny"])
  class r3o out_deny
  r3 -- no --> r4
  r4{"platform_operate: Is the actor a platform manager or steward operating the platform's Joatu?"}
  r4 -- yes --> r4o(["allow"])
  class r4o out_allow
  r4 -- no --> r5
  r5["default_deny: Nothing above matched"]
  r5 --> r5o(["deny"])
  class r5o out_deny
  classDef out_allow fill:#cfe8cf,stroke:#2e6b2e,color:#111
  classDef out_deny fill:#f3d0d0,stroke:#8a2a2a,color:#111
  classDef out_conditional fill:#f6e7b4,stroke:#8a6d1a,color:#111
  classDef unintended stroke:#b00020,stroke-width:3px,stroke-dasharray:6 3,fill:#fde8ea,color:#111
