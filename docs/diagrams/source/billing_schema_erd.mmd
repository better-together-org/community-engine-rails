%% Billing — entity/schema view. Pay's tables are owned by Community Engine: every table that
%% holds tenant data carries a required platform_id, and children are tied to their customer's
%% (or subscription's) platform by COMPOSITE foreign keys (customer_id, platform_id), so a row
%% can never belong to a different platform than its parent. pay_webhooks is transient (Pay
%% deletes a row once its event is processed) and has no platform.
%% Columns marked "encrypted" are Active Record Encryption ciphertext in a text column.
%% The event log is platform-bound too, with its payload and error text encrypted. Plans are
%% platform-bound: the identifier is unique per platform, a processor price id is unique per
%% processor, and a product may be shared by several plans of ONE platform (never by another's).
erDiagram
  EXT_PLATFORM ||--o{ BILLING_EVENTS : "platform / platform_id"
  EXT_PLATFORM ||--o{ BILLING_PLANS : "platform / platform_id"
  EXT_PERSON o|--o{ BILLING_EVENTS : "billable_owner / beneficiary (polymorphic, optional)"
  EXT_COMMUNITY o|--o{ BILLING_EVENTS : "billable_owner / beneficiary (polymorphic, optional)"

  EXT_PLATFORM ||--o{ PAY_CUSTOMERS : "platform / platform_id"
  EXT_PLATFORM ||--o{ PAY_MERCHANTS : "platform / platform_id"
  EXT_PLATFORM ||--o{ PAY_SUBSCRIPTIONS : "platform / platform_id"
  EXT_PLATFORM ||--o{ PAY_PAYMENT_METHODS : "platform / platform_id"
  EXT_PLATFORM ||--o{ PAY_CHARGES : "platform / platform_id"
  EXT_PERSON o|--o{ PAY_CUSTOMERS : "owner / owner_id (polymorphic)"
  EXT_COMMUNITY o|--o{ PAY_CUSTOMERS : "owner / owner_id (polymorphic)"
  EXT_PERSON o|--o{ PAY_MERCHANTS : "owner / owner_id (polymorphic)"
  EXT_COMMUNITY o|--o{ PAY_MERCHANTS : "owner / owner_id (polymorphic)"
  PAY_CUSTOMERS ||--o{ PAY_SUBSCRIPTIONS : "(customer_id, platform_id) composite FK"
  PAY_CUSTOMERS ||--o{ PAY_PAYMENT_METHODS : "(customer_id, platform_id) composite FK"
  PAY_CUSTOMERS ||--o{ PAY_CHARGES : "(customer_id, platform_id) composite FK"
  PAY_SUBSCRIPTIONS o|--o{ PAY_CHARGES : "(subscription_id, platform_id) composite FK"

  PAY_CUSTOMERS {
    uuid id PK "unique with platform_id (composite FK target)"
    uuid platform_id FK "NOT NULL, read-only after create"
    string owner_type "polymorphic owner"
    uuid owner_id
    string processor "e.g. stripe"
    string processor_id "unique per platform and processor"
    boolean default
    text data "encrypted JSON"
    text object "encrypted JSON"
    string stripe_account
    datetime deleted_at
    string type "STI: Pay::Stripe::Customer, ..."
  }

  PAY_MERCHANTS {
    uuid id PK
    uuid platform_id FK "NOT NULL"
    string owner_type
    uuid owner_id
    string processor
    string processor_id
    text data "encrypted JSON"
    string type
  }

  PAY_SUBSCRIPTIONS {
    uuid id PK "unique with platform_id (composite FK target)"
    uuid platform_id FK "NOT NULL, must equal the customer's"
    uuid customer_id FK
    string name
    string processor_id
    string processor_plan
    integer quantity
    string status
    datetime current_period_end
    datetime ends_at
    text metadata "encrypted JSON"
    text data "encrypted JSON"
    text object "encrypted JSON"
    string type
  }

  PAY_PAYMENT_METHODS {
    uuid id PK
    uuid platform_id FK "NOT NULL, must equal the customer's"
    uuid customer_id FK
    string processor_id
    string payment_method_type
    text data "encrypted JSON (brand, last4, ...)"
    string type
  }

  PAY_CHARGES {
    uuid id PK
    uuid platform_id FK "NOT NULL, must equal the customer's and the subscription's"
    uuid customer_id FK
    uuid subscription_id FK "nullable (one-off charge)"
    string processor_id
    integer amount
    string currency
    integer amount_refunded
    text metadata "encrypted JSON"
    text data "encrypted JSON"
    text object "encrypted JSON"
    string type
  }

  PAY_WEBHOOKS {
    uuid id PK
    string processor
    string event_type
    text event "encrypted JSON; no platform; deleted once processed"
  }

  BILLING_EVENTS {
    uuid id PK
    uuid platform_id FK "NOT NULL, read-only after create"
    string processor "unique with event_id, across platforms"
    string event_id "vendor event id, globally unique"
    string event_type
    text payload "encrypted JSON; redacted after retention"
    text error_message "encrypted"
    string processing_status "pending | processed | ignored | alerted | failed | dead_lettered | replayed"
    integer attempt_count
    integer replay_count
    datetime first_received_at
    datetime processor_event_created_at "when the processor says it happened"
    datetime claimed_at "short lease while a job processes it"
    datetime last_attempted_at
    datetime processed_at
    datetime payload_redacted_at
    datetime dead_lettered_at
    string dead_letter_reason "retries_exhausted | stale_unresolved_drift"
    string billable_owner_type
    uuid billable_owner_id
    string beneficiary_type
    uuid beneficiary_id
  }

  BILLING_PLANS {
    uuid id PK
    uuid platform_id FK "NOT NULL, read-only after create"
    string identifier "unique per platform"
    string name
    text description
    string billing_interval "month | year | one_time"
    integer amount_cents
    string currency "no default"
    boolean active
    string processor "must be configured for the platform"
    string processor_price_id "NULL until the processor has created it; unique per processor"
    string processor_product_id "NOT unique: one product, several prices"
    boolean manages_processor_product "false when an existing product was chosen"
    string sync_status "pending | synced | failed"
    string sync_error "short code, never vendor text"
    datetime sync_attempted_at
    datetime synced_to_processor_at
    string latest_processor_event_id
    jsonb metadata "participant text, owner-type allow-list"
  }
