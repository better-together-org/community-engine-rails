%% Billing — entity/schema view. Pay's tables are owned by Community Engine: every table that
%% holds tenant data carries a required platform_id, and children are tied to their customer's
%% (or subscription's) platform by COMPOSITE foreign keys (customer_id, platform_id), so a row
%% can never belong to a different platform than its parent. pay_webhooks is transient (Pay
%% deletes a row once its event is processed) and has no platform.
%% Columns marked "encrypted" are Active Record Encryption ciphertext in a text column.
%% The event log is platform-bound too, with its payload and error text encrypted. Plans are
%% platform-bound: the identifier is unique per platform, a processor price id is unique per
%% processor, and a product may be shared by several plans of ONE platform (never by another's).
erDiagram
  EXT_PLATFORM ||--o{ BILLING_EVENTS : "platform / platform_id"
  EXT_PLATFORM ||--o{ BILLING_PLANS : "platform / platform_id"
  EXT_COMMUNITY o|--o{ BILLING_PLANS : "seller (polymorphic, optional; person too)"
  EXT_PLATFORM ||--o{ BILLING_PROCESSOR_SETTINGS : "platform / platform_id"
  EXT_PLATFORM ||--o{ BILLING_ORDERS : "platform / platform_id"
  EXT_PERSON ||--o{ BILLING_ORDERS : "buyer"
  EXT_COMMUNITY o|--o{ BILLING_ORDERS : "seller / on_behalf_of (polymorphic, optional; person too)"
  BILLING_ORDERS ||--o{ BILLING_ORDER_LINES : "(order_id, platform_id) composite FK"
  BILLING_ORDERS ||--o{ BILLING_PAYMENTS : "(order_id, platform_id) composite FK"
  BILLING_PAYMENTS ||--o{ BILLING_REFUNDS : "(payment_id, platform_id) composite FK"
  BILLING_PLANS o|--o{ BILLING_ORDER_LINES : "purchasable (polymorphic, opt-in)"
  EXT_PLATFORM ||--o{ BILLING_AGREEMENT_REQUIREMENTS : "platform / platform_id"
  EXT_PLATFORM ||--o{ BILLING_NOTIFICATION_RECEIPTS : "platform / platform_id"
  EXT_PERSON ||--o{ BILLING_NOTIFICATION_RECEIPTS : "recipient (cascade delete)"
  EXT_AGREEMENT ||--o{ BILLING_AGREEMENT_REQUIREMENTS : "agreement"
  BILLING_PLANS o|--o{ BILLING_AGREEMENT_REQUIREMENTS : "target (polymorphic: seller or plan; none = platform default)"
  BILLING_ORDERS ||--o{ BILLING_ORDER_AGREEMENT_ACCEPTANCES : "(order_id, platform_id) composite FK"
  EXT_AGREEMENT ||--o{ BILLING_ORDER_AGREEMENT_ACCEPTANCES : "agreement (restrict delete)"
  EXT_PERSON ||--o{ BILLING_ORDER_AGREEMENT_ACCEPTANCES : "signer"
  EXT_COMMUNITY o|--o{ BILLING_PROCESSOR_SETTINGS : "seller (polymorphic, optional; person too)"
  EXT_PLATFORM o|--o{ BILLING_EVENTS : "subject: a setting is the subject of its audit events"
  EXT_PERSON o|--o{ BILLING_EVENTS : "billable_owner / beneficiary (polymorphic, optional)"
  EXT_PLATFORM o|--o{ BILLING_EVENTS : "subject (polymorphic, optional): the hosted platform a hosting event is about"
  EXT_COMMUNITY o|--o{ BILLING_EVENTS : "billable_owner / beneficiary (polymorphic, optional)"

  EXT_PLATFORM ||--o{ PAY_CUSTOMERS : "platform / platform_id"
  EXT_PLATFORM ||--o{ PAY_MERCHANTS : "platform / platform_id"
  EXT_PLATFORM ||--o{ PAY_SUBSCRIPTIONS : "platform / platform_id"
  EXT_PLATFORM ||--o{ PAY_PAYMENT_METHODS : "platform / platform_id"
  EXT_PLATFORM ||--o{ PAY_CHARGES : "platform / platform_id"
  EXT_PERSON o|--o{ PAY_CUSTOMERS : "owner / owner_id (polymorphic)"
  EXT_COMMUNITY o|--o{ PAY_CUSTOMERS : "owner / owner_id (polymorphic)"
  EXT_PERSON o|--o{ PAY_MERCHANTS : "owner / owner_id (polymorphic)"
  EXT_COMMUNITY o|--o{ PAY_MERCHANTS : "owner / owner_id (polymorphic)"
  PAY_CUSTOMERS ||--o{ PAY_SUBSCRIPTIONS : "(customer_id, platform_id) composite FK"
  PAY_CUSTOMERS ||--o{ PAY_PAYMENT_METHODS : "(customer_id, platform_id) composite FK"
  PAY_CUSTOMERS ||--o{ PAY_CHARGES : "(customer_id, platform_id) composite FK"
  PAY_SUBSCRIPTIONS o|--o{ PAY_CHARGES : "(subscription_id, platform_id) composite FK"

  PAY_CUSTOMERS {
    uuid id PK "unique with platform_id (composite FK target)"
    uuid platform_id FK "NOT NULL, read-only after create"
    string owner_type "polymorphic owner"
    uuid owner_id
    string processor "e.g. stripe"
    string processor_id "unique per platform and processor"
    boolean default
    text data "encrypted JSON"
    text object "encrypted JSON"
    string stripe_account
    datetime deleted_at
    string type "STI: Pay::Stripe::Customer, ..."
  }

  PAY_MERCHANTS {
    uuid id PK
    uuid platform_id FK "NOT NULL"
    string owner_type
    uuid owner_id
    string processor
    string processor_id
    text data "encrypted JSON"
    string type
  }

  PAY_SUBSCRIPTIONS {
    uuid id PK "unique with platform_id (composite FK target)"
    uuid platform_id FK "NOT NULL, must equal the customer's"
    uuid customer_id FK
    string name
    string processor_id
    string processor_plan
    integer quantity
    string status
    datetime current_period_end
    datetime ends_at
    text metadata "encrypted JSON"
    text data "encrypted JSON"
    text object "encrypted JSON"
    string type
  }

  PAY_PAYMENT_METHODS {
    uuid id PK
    uuid platform_id FK "NOT NULL, must equal the customer's"
    uuid customer_id FK
    string processor_id
    string payment_method_type
    text data "encrypted JSON (brand, last4, ...)"
    string type
  }

  PAY_CHARGES {
    uuid id PK
    uuid platform_id FK "NOT NULL, must equal the customer's and the subscription's"
    uuid customer_id FK
    uuid subscription_id FK "nullable (one-off charge)"
    string processor_id
    integer amount
    string currency
    integer amount_refunded
    text metadata "encrypted JSON"
    text data "encrypted JSON"
    text object "encrypted JSON"
    string type
  }

  PAY_WEBHOOKS {
    uuid id PK
    string processor
    string event_type
    text event "encrypted JSON; no platform; deleted once processed"
  }

  BILLING_EVENTS {
    uuid id PK
    uuid platform_id FK "NOT NULL, read-only after create"
    string processor "unique with event_id, across platforms"
    string event_id "vendor event id, globally unique"
    string event_type
    text payload "encrypted JSON; redacted after retention"
    text error_message "encrypted"
    string processing_status "pending | processed | ignored | alerted | failed | dead_lettered | replayed"
    integer attempt_count
    integer replay_count
    datetime first_received_at
    datetime processor_event_created_at "when the processor says it happened"
    datetime claimed_at "short lease while a job processes it"
    datetime last_attempted_at
    datetime processed_at
    datetime payload_redacted_at
    datetime dead_lettered_at
    string dead_letter_reason "retries_exhausted | stale_unresolved_drift"
    string billable_owner_type
    uuid billable_owner_id
    string beneficiary_type
    uuid beneficiary_id
    string subject_type "what the event is about; types opt in with Billing::Subjectable"
    uuid subject_id
    string outcome_kind "processor-neutral meaning: payment_failed, refund_issued, ..."
  }

  BILLING_PLANS {
    uuid id PK
    uuid platform_id FK "NOT NULL, read-only after create"
    string seller_type "NULL when the platform sells it; community or person otherwise"
    uuid seller_id "read-only after create"
    string identifier "unique per seller: partial index for platform-sold, another for sellers"
    string name
    text description
    string billing_interval "month | year | one_time"
    integer amount_cents
    string currency "no default"
    boolean active
    string processor "online processor holding the price; NULL for cash/cheque/e-transfer/credit-only plans"
    string accepted_payment_methods "array: non-vendor methods the plan accepts"
    string processor_price_id "NULL until the processor has created it; unique per processor"
    string processor_product_id "NOT unique: one product, several prices"
    boolean manages_processor_product "false when an existing product was chosen"
    string sync_status "pending | synced | failed"
    string sync_error "short code, never vendor text"
    datetime sync_attempted_at
    datetime synced_to_processor_at
    string latest_processor_event_id
    jsonb metadata "participant text, owner-type allow-list"
  }

  BILLING_PROCESSOR_SETTINGS {
    uuid id PK
    uuid platform_id FK "NOT NULL, read-only after create"
    string seller_type "NULL when the platform itself; community or person otherwise"
    uuid seller_id
    string processor "cash | cheque | etransfer; unique per seller (partial indexes)"
    boolean enabled "false by default"
    integer hold_hours "how long an unpaid order is held; 72"
    string grant_on "confirmed | received | cleared"
    string purposes "array: subscription, one_time, ticket, exchange"
    text settings "encrypted JSON: where and how to pay; no default, no limit"
    datetime acknowledged_at "the drawbacks were accepted"
    uuid acknowledged_by_id FK "nullified if the person is removed"
  }

  BILLING_ORDERS {
    uuid id PK "unique with platform_id (composite FK target)"
    uuid platform_id FK "NOT NULL, read-only after create"
    string seller_type "NULL when the platform sells; community or person otherwise"
    uuid seller_id
    uuid buyer_id FK "a person"
    string on_behalf_of_type
    uuid on_behalf_of_id
    string subject_type "what the order is about; opt in with Billing::Subjectable"
    uuid subject_id
    string number "BT-XXXXXXXX, unique per platform"
    string purpose "subscription | one_time | ticket | exchange"
    string status "draft | awaiting_payment | partially_paid | paid | cancelled | expired | partially_refunded | refunded"
    string currency
    integer subtotal_cents
    integer total_cents
    datetime placed_at
    datetime expires_at "end of the payment hold"
    datetime paid_at
    datetime cancelled_at
  }

  BILLING_ORDER_LINES {
    uuid id PK
    uuid platform_id FK "NOT NULL, must equal the order's"
    uuid order_id FK
    string purchasable_type "allow-listed by Billing::Purchasable"
    uuid purchasable_id
    string description "copied when the order was placed"
    integer quantity
    integer unit_amount_cents "copied when the order was placed"
    string currency
    integer position
  }

  BILLING_PAYMENTS {
    uuid id PK "unique with platform_id (composite FK target)"
    uuid platform_id FK "NOT NULL, must equal the order's"
    uuid order_id FK
    string processor "the method: a vendor, cash, ..."
    string status "pending | succeeded | failed | cancelled | partially_refunded | refunded"
    integer amount_cents
    string currency
    string idempotency_key "unique per platform"
    string processor_reference
    datetime paid_at
    datetime failed_at
  }

  BILLING_REFUNDS {
    uuid id PK
    uuid platform_id FK "NOT NULL, must equal the payment's"
    uuid payment_id FK
    uuid recorded_by_id FK "nullified if the person is removed"
    integer amount_cents "never more than is left to refund"
    string currency
    string status "pending | succeeded | failed | recorded"
    string reason
    string idempotency_key "unique per platform"
    string processor_reference
  }

  BILLING_AGREEMENT_REQUIREMENTS {
    uuid id PK
    uuid platform_id FK "NOT NULL, read-only after create"
    uuid agreement_id FK "a purchase (transactional) agreement of the same platform"
    string target_type "NULL = platform default; seller or plan otherwise"
    uuid target_id
    string purpose "NULL = any: subscription | one_time | ticket | exchange"
    string payment_method "NULL = any: cash | cheque | etransfer"
    string mode "additional | replaces_default"
    integer position
  }

  BILLING_ORDER_AGREEMENT_ACCEPTANCES {
    uuid id PK
    uuid platform_id FK "NOT NULL, must equal the order's"
    uuid order_id FK
    uuid agreement_id FK
    uuid signer_id FK "the person who accepted"
    string on_behalf_of_type "optional: the community or person it was for"
    uuid on_behalf_of_id
    string agreement_identifier "as it read then"
    string agreement_title "as it read then"
    string agreement_content_digest "as it read then; never rewritten"
    string acceptance_method "checkout | seller_assisted | ..."
    datetime accepted_at
  }

  BILLING_NOTIFICATION_RECEIPTS {
    uuid id PK
    uuid platform_id FK "NOT NULL, read-only after create"
    uuid recipient_id FK "the person told; the receipt goes with them"
    string kind "order_paid, payment_failed, ... (see the catalog)"
    string audience "buyer | seller | operator"
    string dedupe_key "what it is about; never personal data; unique with platform, recipient and kind"
  }
