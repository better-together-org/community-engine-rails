flowchart LR
  Init["Host initializer<br/>MapLayer.register(key, attribution, licence, url)"] --> Reg[(MapLayer registry)]
  Mappable["Mappable#map_layers"] --> MapLayers["Map#layers"]
  Local["_map partial<br/>layers: and boundary_attribution:"] --> Resolve
  MapLayers --> Resolve["MapLayer.resolve<br/>merge by key"]
