%% render.orientation: portrait
flowchart TD
  A[Organizer opens the event form] --> B["Mixed-search picker\n(single field, no type radio)"]
  B --> C["GET /events/available_locations?search=..."]
  C --> D["EventsController#available_locations\n(location_type omitted)"]
  D --> E{Per Placeable type}
  E -->|Address / Building| F["Policy-scoped:\norganizer's own + public records"]
  E -->|Settlement / Region| G[Unscoped: full curated reference list]
  E -->|Floor / Room| H[Scoped via their building's visibility]
  F --> I
  G --> I
  H --> I["Composite 'ClassName:id' results,\nmerged and type-labeled"]

  I --> J{Organizer's choice}
  J -->|Picks a result| K["applyLocationSelection splits the composite\nvalue into location_id + location_type"]
  J -->|"Types free text, no match\n(addable)"| L["Written to the hidden\nname field instead"]
  J -->|"Clicks '+New'\n(Address/Building only, always available)"| M[Inline new-record fields submitted alongside]

  K --> N["location_id + location_type\nsubmitted as plain fields"]
  L --> N
  N --> O["Ordinary Rails mass assignment\n(belongs_to :location, polymorphic)\n— no custom setter involved"]

  M --> P["LocatableLocation#location_attributes=\n(custom setter, '+New' path only)"]
  P --> Q["klass.locatable_location_build(attrs):\nlooks up by id first,\nonly builds a new record if not found"]

  O --> R["belongs_to :location, autosave: true"]
  Q --> R
  R --> S[Event + location saved together in one submit]
