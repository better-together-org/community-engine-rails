# frozen_string_literal: true

<% modules.each_with_index do |name, i| -%>
<%= '  ' * i %>module <%= name %>
<% end -%>
<% pad = '  ' * modules.size -%>
<%= pad %>class <%= base_class_name %> < <%= parent_class %>
<% concerns.each do |concern| -%>
<%= pad %>  include <%= concern %>
<% end -%>
<% translatable_names.each do |name| -%>

<%= pad %>  translates :<%= name %>, type: :string
<% end -%>
<% if options[:friendly_id] -%>

<%= pad %>  slugged :<%= slug_source %>
<% end -%>
<% reference_attributes.each do |attribute| -%>

<%= pad %>  belongs_to :<%= attribute.name %><%= ', polymorphic: true' if attribute.polymorphic? %>
<% end -%>
<% if translatable_names.any? -%>

<%= pad %>  validates :<%= slug_source %>, presence: true
<% end -%>
<%= pad %>end
<% modules.each_index.reverse_each do |i| -%>
<%= '  ' * i %>end
<% end -%>
