# frozen_string_literal: true

<% modules.each_with_index do |name, i| -%>
<%= '  ' * i %>module <%= name %>
<% end -%>
<% pad = '  ' * modules.size -%>
<%= pad %># Authorization for <%= base_class_name %>. Tighten the rules before use.
<%= pad %>class <%= base_class_name %>Policy < <%= policy_parent %>
<%= pad %>  def index?
<%= pad %>    user.present?
<%= pad %>  end

<%= pad %>  def show?
<%= pad %>    user.present?
<%= pad %>  end

<%= pad %>  def create?
<%= pad %>    permitted_to?('manage_platform')
<%= pad %>  end

<%= pad %>  def update?
<%= pad %>    permitted_to?('manage_platform')
<%= pad %>  end

<%= pad %>  def destroy?
<%= pad %>    permitted_to?('manage_platform')
<%= pad %>  end
<%= pad %>end
<% modules.each_index.reverse_each do |i| -%>
<%= '  ' * i %>end
<% end -%>
