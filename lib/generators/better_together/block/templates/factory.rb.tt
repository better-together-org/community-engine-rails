# frozen_string_literal: true

FactoryBot.define do
  factory :content_<%= block_name %>, class: 'BetterTogether::Content::<%= class_base %>' do
    privacy { 'public' }
<% translatable_fields.each do |name, _| -%>
    <%= name %>_en { '<%= name.humanize %>' }
<% end -%>
<% stored_fields.each do |name, _| -%>
    <%= name %> { '<%= name.humanize %>' }
<% end -%>
  end
end
