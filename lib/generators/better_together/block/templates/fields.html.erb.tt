<%# locals: (block:, scope: BetterTogether::Content::Block.block_name, temp_id: SecureRandom.uuid) -%>
<%%- temp_id = temp_id_for(block, temp_id:) %>
<div class="<%= block_name.dasherize %>-fields">
<% translatable_fields.each do |name, type| -%>
  <%%= render partial: 'better_together/content/blocks/fields/shared/translatable_<%= type %>_field',
             locals: { model: block, scope: scope, temp_id: temp_id, attribute: '<%= name %>',
                       help_text: '<%= name.humanize %>' } %>
<% end -%>
<% stored_fields.each do |name, _| -%>
  <div class="mb-3">
    <%%= label_tag "#{scope}_#{temp_id}_<%= name %>", BetterTogether::Content::Block.human_attribute_name(:<%= name %>) %>
    <%%= text_field_tag "#{scope}[<%= name %>]", block.<%= name %>, id: "#{scope}_#{temp_id}_<%= name %>", class: 'form-control' %>
  </div>
<% end -%>
</div>
