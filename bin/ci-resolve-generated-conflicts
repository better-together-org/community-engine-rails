#!/usr/bin/env bash
# Fixes a pull request whose merge conflicts are ONLY generated files (.github/generated-conflict-paths),
# using GitHub-signed commits so everything shows as verified. Run in two phases around the regeneration:
#
#   --phase merge   1. checks the PR is eligible (open, conflicting, same-repo, only generated files conflict)
#                   2. signed commit on the PR branch that sets those files to the base branch's version, so
#                      both sides agree and nothing conflicts any more
#                   3. asks GitHub to merge the base into the PR branch (update-branch), which GitHub signs
#                   4. leaves the checkout on the new PR head, ready for the diagrams to be regenerated
#   --phase commit  one signed commit with whatever the regeneration changed under db/ and docs/diagrams
#
# Without --apply it only prints the plan. Writes `merged=true|false` to $GITHUB_OUTPUT when set.
# Usage: bin/ci-resolve-generated-conflicts --pr N --phase merge|commit [--apply]
# Env: GH_TOKEN (bts-robot), GITHUB_REPOSITORY, ALLOWLIST (glob file, default .github/generated-conflict-paths), REMOTE (default origin), GH (gh override for local use).
set -euo pipefail

GH="${GH:-gh}"
REMOTE="${REMOTE:-origin}"
# shellcheck disable=SC2034 # read by the sourced lib
ALLOWLIST="${ALLOWLIST:-.github/generated-conflict-paths}"
PR=""; PHASE=""; APPLY=0
REGENERATED_PATHS=(db/community-engine-db.dbml docs/diagrams)

while [ $# -gt 0 ]; do
  case "$1" in
    --pr) PR="$2"; shift ;;
    --phase) PHASE="$2"; shift ;;
    --apply) APPLY=1 ;;
    -h|--help) sed -n 2,16p "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
: "${PR:?--pr is required}" "${PHASE:?--phase is required}" "${GITHUB_REPOSITORY:?}"

cd "$(git rev-parse --show-toplevel)"
# shellcheck source-path=SCRIPTDIR source=lib/pr-conflicts.sh
source "$(dirname "$0")/lib/pr-conflicts.sh"

output() { [ -n "${GITHUB_OUTPUT:-}" ] && echo "$1" >> "$GITHUB_OUTPUT" || true; }
stop() { echo "$1"; output "merged=false"; exit 0; }

pr_field() { "$GH" pr view "$PR" --json "$1" --jq ".$1"; }

# A branch that moved since checkout means a newer push; its own run re-evaluates.
require_tip() { # require_tip <branch> <expected oid>
  git fetch -q "$REMOTE" "$1"
  [ "$(git rev-parse "refs/remotes/${REMOTE}/${1}")" = "$2" ] || stop "Branch ${1} moved since the run started; a newer run will handle it."
}

merge_phase() {
  local state mergeable cross head base oid new files=() f
  state="$(pr_field state)"; mergeable="$(pr_field mergeable)"; cross="$(pr_field isCrossRepository)"
  head="$(pr_field headRefName)"; base="$(pr_field baseRefName)"; oid="$(pr_field headRefOid)"
  [ "$state" = "OPEN" ] || stop "PR #${PR} is ${state}; nothing to do."
  [ "$mergeable" = "CONFLICTING" ] || stop "PR #${PR} is ${mergeable}, not conflicting; nothing to do."
  [ "$cross" = "false" ] || stop "PR #${PR} is from a fork; the robot cannot push to it."

  mapfile -t files < <(conflicted_files "$PR" "$base")
  [ "${#files[@]}" -gt 0 ] || stop "No conflict reproduced for #${PR}; leaving it alone."
  generated_only "${files[@]}" || { printf 'PR #%s has conflicts that need a person:\n' "$PR"; printf '  %s\n' "${files[@]}"; stop "Not resolving."; }

  echo "PR #${PR} (${head} into ${base}): only generated files conflict:"
  printf '  %s\n' "${files[@]}"
  if [ "$APPLY" != 1 ]; then
    echo "[dry run] would set them to ${base}'s version (signed commit), update-branch, regenerate, commit the diff."
    stop "Dry run, no changes made."
  fi

  git fetch -q "$REMOTE" "$head" "$base"
  git checkout -q -B "$head" "refs/remotes/${REMOTE}/${head}"
  require_tip "$head" "$oid"

  for f in "${files[@]}"; do
    if git cat-file -e "refs/remotes/${REMOTE}/${base}:${f}" 2>/dev/null; then
      mkdir -p "$(dirname "$f")"
      git show "refs/remotes/${REMOTE}/${base}:${f}" > "$f"
    else
      rm -f "$f"
    fi
  done
  BRANCH="$head" "$(dirname "$0")/ci-signed-commit" "chore(diagrams): take ${base} versions of generated files before merging" "${files[@]}"

  git fetch -q "$REMOTE" "$head"
  new="$(git rev-parse "refs/remotes/${REMOTE}/${head}")"
  [ "$new" != "$oid" ] || stop "The signed commit was not created (branch moved); a newer run will handle it."
  "$GH" api -X PUT "repos/${GITHUB_REPOSITORY}/pulls/${PR}/update-branch" -f "expected_head_sha=${new}" >/dev/null \
    || { echo "update-branch failed: the merge still conflicts. The extra commit is harmless; a person must resolve it."; output "merged=false"; exit 1; }

  for _ in $(seq 1 24); do
    [ "$(pr_field headRefOid)" != "$new" ] && break
    sleep 5
  done
  [ "$(pr_field headRefOid)" != "$new" ] || { echo "GitHub did not finish the merge in time."; output "merged=false"; exit 1; }

  git fetch -q "$REMOTE" "$head"
  git reset -q --hard "refs/remotes/${REMOTE}/${head}"
  echo "Merged ${base} into ${head}; head is now $(git rev-parse --short HEAD)."
  output "merged=true"
  output "head=${head}"
  output "base=${base}"
}

commit_phase() {
  local head base
  head="$(pr_field headRefName)"; base="$(pr_field baseRefName)"
  if [ -z "$(git status --porcelain -- "${REGENERATED_PATHS[@]}")" ]; then
    echo "Regeneration changed nothing; the merge already left the diagrams current."
    return 0
  fi
  git status --short -- "${REGENERATED_PATHS[@]}" | head -50
  BRANCH="$head" "$(dirname "$0")/ci-signed-commit" "chore(diagrams): regenerate after merging ${base}" "${REGENERATED_PATHS[@]}"
}

case "$PHASE" in
  merge) merge_phase ;;
  commit) commit_phase ;;
  *) echo "unknown phase: $PHASE" >&2; exit 2 ;;
esac
