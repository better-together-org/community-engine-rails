#!/usr/bin/env python3
"""Merge SimpleCov .resultset.json files from CI shards into one line-coverage figure.

Usage: bin/ci-merge-coverage OUTPUT_DIR RESULTSET.json [RESULTSET.json ...]

Hits are summed per file line across all workers and shards. Writes OUTPUT_DIR/.last_run.json in
SimpleCov's shape ({"result": {"covered_percent": N}}) for the coverage badge step (both keys, since SimpleCov versions differ) and prints a
one-line summary.
"""
import json
import os
import sys

if len(sys.argv) < 3:
    sys.exit(__doc__)
out_dir, paths = sys.argv[1], sys.argv[2:]

merged = {}
for path in paths:
    with open(path) as handle:
        for run in json.load(handle).values():
            for filename, data in run.get("coverage", {}).items():
                lines = data["lines"] if isinstance(data, dict) else data
                current = merged.setdefault(filename, [None] * len(lines))
                if len(current) < len(lines):
                    current.extend([None] * (len(lines) - len(current)))
                for i, hits in enumerate(lines):
                    if hits is not None:
                        current[i] = (current[i] or 0) + hits

relevant = sum(1 for lines in merged.values() for hits in lines if hits is not None)
covered = sum(1 for lines in merged.values() for hits in lines if hits)
percent = round(100.0 * covered / relevant, 2) if relevant else 0.0

os.makedirs(out_dir, exist_ok=True)
with open(os.path.join(out_dir, ".last_run.json"), "w") as handle:
    json.dump({"result": {"covered_percent": percent, "line": percent}}, handle)
print(f"Merged line coverage: {percent}% ({covered}/{relevant} lines, {len(merged)} files, {len(paths)} resultsets)")
