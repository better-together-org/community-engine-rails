#!/usr/bin/env bash
# Pre-commit hook
#   1. Ensure ActiveRecord schema and migration versions use 7.2, never 8.x
#   2. Run rubocop -A on staged Ruby files and re-stage auto-corrections
#   3. Run i18n-tasks health when locale/Ruby files are staged
#   4. Regenerate the schema/subsystem/Mermaid diagrams when anything they derive from is staged, and stage the result
#
# Install: bin/install-git-hooks (or manually symlink to .git/hooks/pre-commit)

set -euo pipefail

REQUIRED_VERSION="7.2"
FIXED=0

# Check staged files only; rewrite any ActiveRecord [8.x] version to 7.2
staged_files=$(git diff --cached --name-only --diff-filter=ACM)

for file in $staged_files; do
  case "$file" in
    spec/dummy/db/schema.rb|db/migrate/*.rb)
      changed=$("$(git rev-parse --show-toplevel)/bin/normalize-ar-versions" -v "$REQUIRED_VERSION" "$file")
      if [ -n "$changed" ]; then
        git add "$file"
        FIXED=$((FIXED + 1))
        echo "pre-commit: Fixed ActiveRecord version to ${REQUIRED_VERSION} in $file"
      fi
      ;;
  esac
done

if [ "$FIXED" -gt 0 ]; then
  echo "pre-commit: Auto-fixed $FIXED file(s) to use ActiveRecord version [${REQUIRED_VERSION}]"
fi

# ---------------------------------------------------------------------------
# RuboCop: auto-correct staged Ruby files then fail on remaining offenses
# ---------------------------------------------------------------------------
# Determine staged Ruby files (skip generated dummy files)
staged_ruby=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(rb|rake|gemspec|jbuilder)$' \
  | grep -v '^spec/dummy/db/' \
  || true)

if [ -n "$staged_ruby" ]; then
  echo "pre-commit: Running rubocop -A on staged Ruby files…"

  # Prefer bin/dc-run (Docker-based env) so the hook works even when the local
  # gem environment is stale after a Gemfile.lock update.
  if [ -x "$(git rev-parse --show-toplevel)/bin/dc-run" ]; then
    rubocop_cmd="$(git rev-parse --show-toplevel)/bin/dc-run rubocop"
  else
    rubocop_cmd="bundle exec rubocop"
  fi

  # Run rubocop -A; capture exit code without aborting via set -e
  rubocop_exit=0
  # shellcheck disable=SC2086
  $rubocop_cmd -A $staged_ruby || rubocop_exit=$?

  # Re-stage any files rubocop auto-corrected
  # shellcheck disable=SC2086
  git add $staged_ruby

  if [ "$rubocop_exit" -ne 0 ]; then
    echo ""
    echo "pre-commit: ✗ RuboCop found offenses that could not be auto-corrected."
    echo "            Fix the remaining issues above, then re-stage and commit."
    exit 1
  fi

  echo "pre-commit: ✓ RuboCop clean."
fi

# ---------------------------------------------------------------------------
# i18n-tasks health: run when locale YML or Ruby files are staged
# ---------------------------------------------------------------------------
staged_i18n=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(rb|yml|yaml)$' \
  | grep -v '^spec/' \
  || true)

if [ -n "$staged_i18n" ]; then
  echo "pre-commit: Running i18n-tasks health…"

  if [ -x "$(git rev-parse --show-toplevel)/bin/dc-run" ]; then
    i18n_cmd="$(git rev-parse --show-toplevel)/bin/dc-run i18n-tasks"
  else
    i18n_cmd="bundle exec i18n-tasks"
  fi

  i18n_exit=0
  $i18n_cmd health || i18n_exit=$?

  if [ "$i18n_exit" -ne 0 ]; then
    echo ""
    echo "pre-commit: ✗ i18n-tasks health check failed."
    echo "            Run 'bin/i18n all' to normalize and fix missing/unused keys, then re-stage."
    exit 1
  fi

  echo "pre-commit: ✓ i18n-tasks health clean."
fi

# ---------------------------------------------------------------------------
# Diagrams: mirror the schema-diagrams and diagrams CI jobs, auto-correct by regenerating
# ---------------------------------------------------------------------------
# Regenerates when a staged file feeds a diagram: the schema, migrations, models, controllers, any .mmd source or the
# generator scripts. Stale output is rewritten and staged into this commit. Skip with SKIP_DIAGRAMS=1.
staged_diagram_inputs=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(spec/dummy/db/schema\.rb|db/migrate/|app/(models|controllers)/|docs/diagrams/source/.*\.mmd|scripts/(export_schema_dbml|export_subsystem_diagrams|render_schema_diagram)|bin/(export_schema_diagrams|export_subsystem_diagrams|render_diagrams|check_diagrams))' \
  || true)

if [ -n "$staged_diagram_inputs" ] && [ "${SKIP_DIAGRAMS:-0}" != "1" ]; then
  echo "pre-commit: Regenerating diagrams (SKIP_DIAGRAMS=1 to skip)…"
  diagram_exit=0
  "$(git rev-parse --show-toplevel)/bin/check_diagrams" --fix || diagram_exit=$?

  if [ "$diagram_exit" -ne 0 ]; then
    echo ""
    echo "pre-commit: ✗ Diagram regeneration failed (see output above); a .mmd source may not render."
    exit 1
  fi

  echo "pre-commit: ✓ Diagrams current."
fi

exit 0
