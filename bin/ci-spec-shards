#!/usr/bin/env python3
"""Print the spec files for one CI shard, balanced by recorded runtime.

Usage: bin/ci-spec-shards INDEX TOTAL [--kind all|other|browser] [--weights config/ci/spec_runtimes.json]

--kind browser lists only files that may hold browser (js/feature/system) examples; run those
with `--tag js --tag feature --tag system`. --kind other lists every file; run those with
`--tag ~js --tag ~feature --tag ~system`. The two tag filters partition all examples, and the
split keeps :deletion-cleaned browser examples out of the transaction-cleaned workers' database.

INDEX is 1-based. Spec files are packed longest-first into TOTAL bins (deterministic for a given
file list and weights file), so every shard gets a similar amount of work. Files missing from the
weights file get the median weight. Regenerate the weights from a full run's JSON results with:

  bin/ci-timing-summary --write-weights tmp/rspec_results.json > config/ci/spec_runtimes.json
"""
import glob
import json
import os
import re
import statistics
import sys

args = sys.argv[1:]
weights_path = "config/ci/spec_runtimes.json"
if "--weights" in args:
    i = args.index("--weights")
    weights_path = args[i + 1]
    del args[i : i + 2]
kind = "all"
if "--kind" in args:
    i = args.index("--kind")
    kind = args[i + 1]
    del args[i : i + 2]
if kind not in ("all", "other", "browser"):
    sys.exit("--kind must be all, other or browser")
if len(args) != 2:
    sys.exit(__doc__)
index, total = int(args[0]), int(args[1])
if not 1 <= index <= total:
    sys.exit(f"INDEX must be between 1 and {total}")

files = sorted(
    f for f in glob.glob("spec/**/*_spec.rb", recursive=True)
    if not f.startswith(("spec/dummy/", "spec/support/"))
)
# Same predicate as the :deletion cleaner in spec/rails_helper.rb (js/feature/system metadata).
# Deliberately loose: a file wrongly listed as browser only costs load time under the tag filter.
BROWSER = re.compile(r":(js|feature|system)\b|\bjs:|RSpec\.feature|^\s*feature\s|type:\s*:(feature|system)", re.M)


def holds_browser_examples(path):
    with open(path, encoding="utf-8") as handle:
        return bool(BROWSER.search(handle.read()))


if kind == "browser":
    files = [f for f in files if holds_browser_examples(f)]

weights = {}
if os.path.exists(weights_path):
    with open(weights_path) as handle:
        weights = json.load(handle)
default = statistics.median(weights.values()) if weights else 1.0

bins = [[0.0, []] for _ in range(total)]
for f in sorted(files, key=lambda f: (-weights.get(f, default), f)):
    lightest = min(bins, key=lambda b: (b[0], len(b[1])))
    lightest[0] += weights.get(f, default)
    lightest[1].append(f)

print(" ".join(sorted(bins[index - 1][1])))
if os.environ.get("CI_SHARD_VERBOSE"):
    for n, (load, members) in enumerate(bins, 1):
        print(f"shard {n}: {len(members)} files, weight {load:.0f}s", file=sys.stderr)
