#!/usr/bin/env bash
# Finds open pull requests that conflict with their base branch and reports them: a `merge-conflict`
# label plus one comment (edited in place, never repeated) naming the conflicted files and whether
# they are all generated files (.github/generated-conflict-paths). Removes both marks when a PR is
# mergeable again. It never changes a PR's branch.
#
# Usage: bin/ci-pr-conflict-sweep [--base BRANCH] [--apply]
#   --base BRANCH  only PRs targeting BRANCH (default: every open PR)
#   --apply        write labels and comments (default: print what would be done)
# Env: REMOTE (git remote name, default origin), GH_TOKEN (the bts-robot token in CI), GITHUB_REPOSITORY, GH (gh command override, for local use).
# Needs a checkout with full history of the base branches.
set -euo pipefail

GH="${GH:-gh}"
REMOTE="${REMOTE:-origin}"
LABEL="merge-conflict"
MARKER="<!-- pr-conflict-sweep -->"
ALLOWLIST=".github/generated-conflict-paths"
BASE=""
APPLY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --base) BASE="$2"; shift ;;
    --apply) APPLY=1 ;;
    -h|--help) sed -n 2,12p "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

: "${GITHUB_REPOSITORY:?}"
cd "$(git rev-parse --show-toplevel)"

patterns=()
while IFS= read -r line; do
  [[ -z "$line" || "$line" == \#* ]] && continue
  patterns+=("$line")
done < "$ALLOWLIST"

generated_only() {
  local file pattern matched
  for file in "$@"; do
    matched=0
    for pattern in "${patterns[@]}"; do
      # shellcheck disable=SC2053 # the pattern is meant to be a glob
      [[ "$file" == $pattern ]] && { matched=1; break; }
    done
    [ "$matched" = 1 ] || return 1
  done
}

act() { # act <description> <command...>: run it with --apply, otherwise only say it
  local what="$1"; shift
  if [ "$APPLY" = 1 ]; then "$@"; else echo "  [dry run] would ${what}"; fi
}

# GitHub works out "mergeable" lazily, so UNKNOWN right after a push means "ask again".
mergeable_state() {
  local number="$1" state
  for _ in 1 2 3 4 5 6 7 8; do
    state="$("$GH" pr view "$number" --json mergeable --jq .mergeable)"
    [ "$state" != "UNKNOWN" ] && { echo "$state"; return; }
    sleep 15
  done
  echo UNKNOWN
}

# Names of the files a merge of the PR head into its base cannot resolve, one per line.
conflicted_files() {
  local number="$1" base="$2" scratch
  scratch="$(mktemp -d)"
  git fetch -q "$REMOTE" "$base" "+pull/${number}/head:refs/sweep/pr-${number}"
  git worktree add -q --detach "$scratch" "refs/sweep/pr-${number}"
  git -C "$scratch" merge --no-commit --no-ff "${REMOTE}/${base}" >/dev/null 2>&1 || true
  git -C "$scratch" diff --name-only --diff-filter=U
  git -C "$scratch" merge --abort >/dev/null 2>&1 || true
  git worktree remove --force "$scratch"
  git update-ref -d "refs/sweep/pr-${number}"
}

existing_comment_id() {
  "$GH" api "repos/${GITHUB_REPOSITORY}/issues/$1/comments" --paginate \
    --jq "[.[] | select(.body | contains(\"${MARKER}\"))][0].id // empty"
}

post_comment() { # post_comment <number> <body-file>
  local id
  id="$(existing_comment_id "$1")"
  if [ -n "$id" ]; then
    "$GH" api -X PATCH "repos/${GITHUB_REPOSITORY}/issues/comments/${id}" -F body=@"$2" >/dev/null
  else
    "$GH" pr comment "$1" --body-file "$2" >/dev/null
  fi
}

add_label() {
  "$GH" label create "$LABEL" --color d73a4a --description 'Has merge conflicts with its base branch' >/dev/null 2>&1 || true
  "$GH" pr edit "$1" --add-label "$LABEL" >/dev/null
}

report_conflict() { # report_conflict <number> <base> <files...>
  local number="$1" base="$2"; shift 2
  local body kind
  if generated_only "$@"; then kind="only generated files, which can be regenerated"; else kind="includes files that need a person"; fi
  echo "PR #${number} conflicts with ${base} (${kind}):"
  printf '  %s\n' "$@"
  body="$(mktemp)"
  {
    echo "$MARKER"
    echo "This pull request has merge conflicts with \`${base}\`. Conflict is ${kind}."
    echo
    echo "Conflicted files:"
    # shellcheck disable=SC2016 # backticks here are Markdown, not a command
    printf -- '- `%s`\n' "$@"
    echo
    echo "_Posted by the PR conflict sweep. It updates this comment and removes the \`${LABEL}\` label when the conflict is gone._"
  } > "$body"
  act "label and comment on #${number}" add_label "$number"
  if [ "$APPLY" = 1 ]; then post_comment "$number" "$body"; fi
  rm -f "$body"
}

clear_conflict() { # clear_conflict <number>
  local number="$1" id body
  if ! "$GH" pr view "$number" --json labels --jq '.labels[].name' | grep -qx "$LABEL"; then return 0; fi
  echo "PR #${number} is mergeable again."
  act "remove the label from #${number}" "$GH" pr edit "$number" --remove-label "$LABEL"
  if [ "$APPLY" = 1 ]; then
    id="$(existing_comment_id "$number")"
    if [ -n "$id" ]; then
      body="$(mktemp)"
      printf '%s\nThe merge conflict is resolved.\n' "$MARKER" > "$body"
      post_comment "$number" "$body"
      rm -f "$body"
    fi
  fi
}

list_args=(pr list --state open --limit 200 --json "number,baseRefName")
[ -n "$BASE" ] && list_args+=(--base "$BASE")

found=0
while read -r number base; do
  [ -z "$number" ] && continue
  state="$(mergeable_state "$number")"
  case "$state" in
    CONFLICTING)
      found=$((found + 1))
      mapfile -t files < <(conflicted_files "$number" "$base")
      if [ "${#files[@]}" -eq 0 ]; then
        echo "PR #${number}: GitHub reports a conflict but none reproduced locally; leaving it alone."
      else
        report_conflict "$number" "$base" "${files[@]}"
      fi
      ;;
    MERGEABLE) clear_conflict "$number" ;;
    *) echo "PR #${number}: mergeable state still ${state}; will be checked on the next run." ;;
  esac
done < <("$GH" "${list_args[@]}" --jq '.[] | "\(.number) \(.baseRefName)"')

echo "Sweep done. Conflicting PRs: ${found}."
