{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://communityengine.app/schemas/seed-packet/2.0/envelope.schema.json",
  "title": "Seed packet envelope (protocol 2.0), the object under the root key",
  "type": "object",
  "required": ["version", "seed", "seed_pack", "packet"],
  "properties": {
    "version": { "type": "string", "pattern": "^2\\.[0-9]+$" },
    "seed": {
      "type": "object",
      "required": ["type", "identifier", "created_by", "created_at", "description", "origin"],
      "properties": {
        "type": { "const": "BetterTogether::Seed" },
        "identifier": { "$ref": "#/$defs/identifier" },
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "description": { "type": "string", "minLength": 1 },
        "origin": {
          "type": "object",
          "properties": {
            "platforms": { "type": "array", "items": { "type": "string" } },
            "contributors": { "type": "array", "items": { "type": "string" } },
            "license": { "type": "string" },
            "usage_notes": { "type": "string" },
            "signing_key_id": { "type": "string", "minLength": 1 }
          }
        },
        "seedable_type": { "type": "string" },
        "seedable_id": { "type": "string" }
      }
    },
    "seed_pack": {
      "type": "object",
      "required": ["schema_version", "pack_type", "install_tier"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "pack_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "install_tier": { "enum": ["core", "recommended", "optional", "demo"] },
        "marketing_name": { "type": "string" },
        "category": { "type": "string" },
        "selectable_in_setup_wizard": { "type": "boolean" },
        "default_selected": { "type": "boolean" },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "applies_to": { "type": "array", "items": { "enum": ["host_platform", "community", "demo", "platform"] } },
        "installer": { "type": "string" },
        "replaces_builder": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "packet": {
      "type": "object",
      "required": ["id", "version", "mode", "default_locale", "records"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
        "mode": { "enum": ["add_only", "upsert", "managed"] },
        "default_locale": { "$ref": "#/$defs/locale" },
        "locales": { "type": "array", "items": { "$ref": "#/$defs/locale" } },
        "unsupported_locale_policy": { "enum": ["fail", "skip", "fallback_default"] },
        "target": {
          "type": "object",
          "properties": { "platform_identifier": { "$ref": "#/$defs/identifier" } },
          "additionalProperties": false
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^records/[A-Za-z0-9_./-]+\\.yml$" }
        },
        "manifest": { "type": "string", "pattern": "^MANIFEST\\.json$" },
        "signature": { "type": "string", "pattern": "^MANIFEST\\.json\\.(sig|asc)$" },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      },
      "additionalProperties": false
    },
    "deletes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "key"],
        "properties": {
          "type": { "$ref": "#/$defs/type_name" },
          "key": { "$ref": "#/$defs/key" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "type_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,254}$" }
  }
}
